','data:image/png;base64,','data:image/png;base64,','data:image/png;base64,'],
    'happy':['data:image/png;base64,','data:image/png;base64,','data:image/png;base64,'],
  };
const ROSE_IMG = "data:image/png;base64,";
const CAKE_IMG = "data:image/png;base64,";
  const UP1_IMG = 'data:image/png;base64,';   // 起身中间帧1：跪坐挺起身
  const UP2_IMG = 'data:image/png;base64,';   // 起身中间帧2：站直伸懒腰


(function(){
  const figEl  = document.getElementById('fig');
  const actEl  = document.getElementById('act');
  const actImg = document.getElementById('actImg');
  const actImg2 = document.getElementById('actImg2');
  const actImg3 = document.getElementById('actImg3');
   const zzzEl = document.getElementById('zzz');
   const petEl  = document.getElementById('pet');

  // 拖拽被拎起：隐藏待机立绘，显示 dragCarry（>< 晕眼）帧，开提起摇晃动画
  function enterDrag(){
    stopAction();
    _dragging=true;
    figEl.style.opacity='0';
    actEl.style.display='block';              // 关键：#act 默认 display:none，必须显示出来，否则 actImg 即使 block 也不会渲染（桌宠会整个消失）
    actImg.src = (ACTIONS.dragCarry && ACTIONS.dragCarry[0]) || '';
    actImg.style.display='block'; actImg.style.opacity='1';
    document.body.classList.add('acting');   // 黑块修复：动作期间关 #shade/#form 变暗层
    rig.classList.add('dragging');            // 提起 + 轻轻晃（像被提着后颈摇晃）
  }
  function exitDrag(){
    _dragging=false;
    figEl.style.opacity='';
    actEl.style.display='';                   // 复位 #act 为 CSS 默认（display:none），与 stopAction 一致
    actImg.style.display='none'; actImg.removeAttribute('src');
    document.body.classList.remove('acting');
    rig.classList.remove('dragging');
  }
  // 落地倒地：被抛出后着地 → 显示"坐地晕眩"帧（sitDizzy），不切回待机
  // 坐地晕 5s → 起身（坐下→站立衔接）→ 站立生气一次 → 抱胸鼓嘴生气保持 1 分钟 → 待机
  function landDizzy(){
    _thrown = false;                 // 落地，结束"被抛出"标记（全局标记，见第一段拖拽监听）
    _dragging = false;              // 结束"被拎起"状态（停 carrySway，恢复呼吸）
    rig.classList.remove('dragging');   // 停止提起摇晃动画
    playAction('sitDizzy');         // 播放"坐地晕眩"循环动画（脑袋轻微左右摇晃），落地后不回待机
    _angrySeq++;                    // 作废上一轮可能的残留链路
    const seq = _angrySeq;
    if(_dizzyAngryTimer) clearTimeout(_dizzyAngryTimer);
    if(_angryIdleTimer) clearTimeout(_angryIdleTimer);
    _dizzyAngryTimer = setTimeout(function(){ triggerDizzyAngry(seq); }, 5000);
  }
  function triggerDizzyAngry(seq){
    _dizzyAngryTimer = null;
    if(seq !== _angrySeq) return;   // 已被打断（送礼/其它动作）
    // 1) 坐下 → 站立 衔接：当前鸭子坐帧向上撑起并淡出，站立帧淡入（复用 .sit-anim 思路）
    document.body.classList.add('acting');
    actImg.style.transition = 'transform .55s ease-out, opacity .55s ease-out';
    actImg.style.transform = 'translateY(-56px) scale(1.05)';
    actImg.style.opacity = '0';
    actImg2.src = (ACTIONS.angry && ACTIONS.angry[0]) || '';
    actImg2.style.display = 'block';
    actImg2.style.transition = 'transform .55s ease-out, opacity .55s ease-out';
    actImg2.style.transform = 'translateY(44px) scale(0.95)';
    actImg2.style.opacity = '0';
    void actImg2.offsetWidth;        // 固化起始态（无过渡）
    actImg2.style.transform = 'translateY(0) scale(1)';
    actImg2.style.opacity = '1';
    _trT1 = setTimeout(function(){
      actImg.style.transition=''; actImg2.style.transition='';   // 清掉起身过渡，避免影响后续动作帧
      if(seq !== _angrySeq){ actImg2.style.opacity='0'; actImg.style.opacity=''; actImg.style.transform=''; return; }
      // 2) 站立生气（既有 angry 动作）播放一次
      playOnce('angrySeq', function(){
        if(seq !== _angrySeq) return;
        // 3) 抱胸鼓嘴生气，保持 1 分钟
        playOnceFreeze('angryPout', function(){
          if(seq !== _angrySeq) return;
          if(_angryIdleTimer) clearTimeout(_angryIdleTimer);
          _angryIdleTimer = setTimeout(function(){ returnToIdle(seq); }, 60000);
        });
      });
    }, 600);
  }
  function returnToIdle(seq){
    _angryIdleTimer = null;
    if(seq !== _angrySeq) return;
    _angrySeq++;                    // 作废链路
    stopAction();                   // 1 分钟无操作 → 恢复待机动作
  }
  // 单次播放某动作，播完一整轮后定格在最后一帧（不清空画面、不回待机）。用于"生气后保持末帧"
  function playOnceFreeze(name, cb){
    if(!ACTIONS[name]){ if(cb) cb(); return; }
    stopAction();
    _name = name; _sitMode = false;
    figEl.style.opacity='0';
    actEl.style.display='block';
    document.body.classList.add('acting');    // 黑块修复：动作期间关闭 #shade/#form 变暗层
    const seq = ACTIONS[name], r = RHYTHM[name]||[];
    let i = 0;
    (function step2(){
      actImg.src = seq[i];
      const dur = r[i] || DEFAULT_MS;
      if(i >= seq.length-1){
        _timer = setTimeout(function(){
          _timer = null;                       // 清空循环定时器，定格在末帧
          actImg.src = seq[seq.length-1];
          if(cb) cb();
        }, dur + 150);
        return;
      }
      _timer = setTimeout(function(){ i++; step2(); }, dur);
    })();
  }
  window.__enterDrag = enterDrag;
  window.__exitDrag = exitDrag;
  window.__landDizzy = landDizzy;
  let _name=null, _timer=null, _idx=0, _sitMode=false;
  /* 每帧独立停留时长(ms)：起手和收势慢、中间过程略快、末帧多停一拍。
     真人做动作不是匀速的——匀速循环会像机器。总循环约 1.6~2.3s（原为 0.88s）。 */
  const RHYTHM = {
    wave:   [320, 150, 165, 175, 175, 170, 165, 340],
    heart:  [320, 170, 190, 215, 195, 195, 185, 340],
    cute:   [320, 180, 215, 245, 215, 225, 210, 340],
    angry:  [300, 155, 175, 200, 180, 205, 215, 340], angrySeq: [300,155,175,200,180,205,215],
    sleepy: [360, 210, 250, 280, 250, 240, 255, 380],
    sitSleepy: [1000], sitDizzy: [140,140,140,140,140,140,140,140], standUp: [800], angryPout: [1000], sitSurprise:[750], sitHappy:[750], sitHeart:[750], sitReceive:[1000], sitEat:[900]
  ,
    surprise:[200,180,320,180,260],
    receive:[360,220,240,260,240,240,260,460],
    eat:[340,260,300,460],
    happy:[320,300,320]
  };
  const DEFAULT_MS = 190;

  function stopAction(){
    if(_timer){ clearTimeout(_timer); _timer=null; }
    if(_sitEndTimer){ clearTimeout(_sitEndTimer); _sitEndTimer=null; }
    if(_dizzyAngryTimer){ clearTimeout(_dizzyAngryTimer); _dizzyAngryTimer=null; }
    if(_angryIdleTimer){ clearTimeout(_angryIdleTimer); _angryIdleTimer=null; }
    if(_trT1){ clearTimeout(_trT1); _trT1=null; }
    if(_trT2){ clearTimeout(_trT2); _trT2=null; }
    if(_upT1){ clearTimeout(_upT1); _upT1=null; }
    if(_upT2){ clearTimeout(_upT2); _upT2=null; }
    if(_upT3){ clearTimeout(_upT3); _upT3=null; }
    if(_upT4){ clearTimeout(_upT4); _upT4=null; }
    if(_cuteEndTimer){ clearTimeout(_cuteEndTimer); _cuteEndTimer=null; }
    if(_cutePhase2){ clearTimeout(_cutePhase2); _cutePhase2=null; }
    actEl.classList.remove('pet-nuzzle','pet-reach'); actEl.style.transform='';
    if(_handEl && _handEl.parentNode){ _handEl.remove(); _handEl=null; }
    window.__setEyesClosed(false);
    _name=null; _sitMode=false; _transitioning=false;
    actEl.style.display='none';
    actImg.removeAttribute('src'); actImg.style.display=''; actImg.style.transform=''; actImg.style.opacity='';
    actImg2.removeAttribute('src'); actImg2.style.opacity='0'; actImg2.style.transform='';
    actImg3.removeAttribute('src'); actImg3.style.opacity='0'; actImg3.style.transform='';
    actImg.classList.remove('sit-anim'); actImg2.classList.remove('sit-anim'); actImg3.classList.remove('sit-anim');   // 清残留过渡，避免后续动作帧被 0.7s 缓动拖着滑
    zzzEl.classList.remove('on');          // 退出坐下困时收起 Zzz，避免回待机后仍飘
    actEl.classList.remove('act-fade'); figEl.classList.remove('fig-fade');
    actEl.style.opacity='';                // 起身时淡出过，必须复位，否则之后动作层一直透明
    figEl.style.opacity='';
    document.body.classList.remove('acting');   // 黑块修复：恢复待机光影层
    document.querySelectorAll('#panel button').forEach(b=>b.classList.remove('on'));
  }
  function playAction(name){
    if(!ACTIONS[name]) return;
    if(_name===name) return;            // already looping this action
    stopAction();
    _name=name; _sitMode=(name==='sitSleepy');
    figEl.style.opacity='0';            // 只隐藏待机立绘，保留 #rig 的光影层
    actEl.style.display='block';
    document.body.classList.add('acting');    // 黑块修复：动作期间关闭 #shade/#form 变暗层，杜绝深色外溢
    actImg.style.display='block'; actImg.style.opacity='1';   // 关键：坐下困后主图层被隐藏过，必须恢复，否则动作帧不显示
    _busyUntil=0;                       // 用户主动操作 → 立即解除「打盹忙碌」保护（否则 5.5 分钟内无法送礼/撒娇）
    _idx=0; step();
    function step(){
      const seq=ACTIONS[name], r=RHYTHM[name]||[];
      actImg.src=seq[_idx];
      _timer=setTimeout(function(){
        _idx=(_idx+1)%seq.length; step();
      }, r[_idx]||DEFAULT_MS);
    }
    const btn=document.querySelector('#panel button[data-act="'+name+'"]');
    if(btn) btn.classList.add('on');
    if(name==='sitSleepy'){             // 直接点「坐下困」（不经犯困链路）也走 5 分钟回待机
      if(_sitEndTimer) clearTimeout(_sitEndTimer);
      _sitEndTimer=setTimeout(_sitEnd, 5*60000);
    }
  }
  function freeze(idx){
    if(_timer){ clearTimeout(_timer); _timer=null; }
    if(!_name) return;
    _idx=idx; actImg.src=ACTIONS[_name][_idx];
  }
  window.__freeze = freeze;

  document.querySelectorAll('#panel button[data-act]').forEach(function(b){
    b.addEventListener('click', function(){
      const a=b.getAttribute('data-act');
      if(a==='idle'){                     // 坐在地上时先自然起身，再回待机
        if((_sitMode || _name==='sitSleepy') && !_transitioning) standUpTransition();
        else stopAction();
      }
      else if(a==='sleepy') goSleepy();
      else playAction(a);
    });
  });
  /* ===== 交互区分：单击=打招呼，双击=撒娇(摸头)，拖拽=移动 ===== */
  let _dx=0,_dy=0,_moved=false, _clickCount=0, _clickTimer=null;
  petEl.addEventListener('pointerdown', function(e){ _dx=e.clientX; _dy=e.clientY; _moved=false; });
  petEl.addEventListener('pointermove', function(e){
    if(Math.abs(e.clientX-_dx)>4 || Math.abs(e.clientY-_dy)>4) _moved=true;   // 超过阈值视为拖拽，不计入点击
  });
  petEl.addEventListener('pointerup', function(){
    if(_moved) return;                       // 拖拽（移动超过阈值）不触发任何点击行为，与单击/双击互不冲突
    _clickCount++;
    if(_clickCount===1){
      // 先等待一小段时间，判断是否还会出现第二次点击（双击）
      _clickTimer = setTimeout(function(){
        _clickCount=0; _clickTimer=null;
        playOnce('wave');                    // 单击：原地打招呼一次（原有行为）
      }, 260);
    } else if(_clickCount===2){
      if(_clickTimer){ clearTimeout(_clickTimer); _clickTimer=null; }
      _clickCount=0;
      playCute();                            // 双击：撒娇（摸头），且不会误触发两次单击
    }
  });

  /* 撒娇：头顶出现一只手抚摸头部，桌宠闭眼、露出享受表情与姿态。
     复用 cute 动作帧表现"享受"，强制闭眼（眼睑系统），并用 DOM 覆盖层画出抚摸的手。 */
  function showHand(){
    if(_handEl && _handEl.parentNode) return;
    var h=document.createElement('div'); h.className='pet-hand';
    h.innerHTML='<div class="ph-in"><svg viewBox="0 0 64 64" width="64" height="64" xmlns="http://www.w3.org/2000/svg">'+
      '<g fill="#ffe0bd" stroke="#e6a87c" stroke-width="2.2" stroke-linejoin="round">'+
      '<rect x="21" y="0" width="22" height="20" rx="7"/>'+          // 前臂（从上方伸入）
      '<ellipse cx="32" cy="31" rx="21" ry="16"/>'+                  // 手掌
      '<rect x="12" y="34" width="8" height="18" rx="4" transform="rotate(-14 16 43)"/>'+
      '<rect x="23" y="39" width="8" height="22" rx="4"/>'+
      '<rect x="33" y="39" width="8" height="22" rx="4"/>'+
      '<rect x="43" y="34" width="8" height="18" rx="4" transform="rotate(14 47 43)"/>'+
      '<rect x="50" y="27" width="8" height="14" rx="4" transform="rotate(30 54 34)"/>'+
      '</g></svg></div>';
    petEl.appendChild(h); _handEl=h;
  }
  function hideHand(){ if(_handEl && _handEl.parentNode){ _handEl.remove(); _handEl=null; } }
  /* 撒娇/抚摸（双击）：连贯两段式
     阶段1：手从上方落下、在头顶左右来回抚摸；桌宠睁眼抬头、略前倾（期待被摸）。
     阶段2：桌宠主动蹭向那只手（向上贴合 + 左右轻蹭）、闭眼，呈享受放松态。 */
  function playCute(){
    if(!ACTIONS.cute) return;
    stopAction();                            // 清场（顺带移除手、恢复睁眼、收起残留姿态）
    _name='__cute__'; _sitMode=false;
    figEl.style.opacity='0';
    actEl.style.display='block';
    document.body.classList.add('acting');
    const seq=ACTIONS.cute, r=RHYTHM.cute||[];
    let i=0;
    (function step(){ actImg.src=seq[i]; _timer=setTimeout(function(){ i=(i+1)%seq.length; step(); }, r[i]||DEFAULT_MS); })();
    // —— 阶段1：手落下并左右抚摸；桌宠睁眼、略前倾期待 ——
    window.__setEyesClosed(false);
    showHand();
    actEl.classList.add('pet-reach');
    // —— 阶段2：桌宠主动蹭向手、闭眼、放松享受 ——
    if(_cutePhase2) clearTimeout(_cutePhase2);
    _cutePhase2=setTimeout(function(){
      actEl.classList.remove('pet-reach');
      actEl.classList.add('pet-nuzzle');
      window.__setEyesClosed(true);
    }, 1500);
    // —— 收尾：收手、睁眼、回待机 ——
    if(_cuteEndTimer) clearTimeout(_cuteEndTimer);
    _cuteEndTimer=setTimeout(function(){
      actEl.classList.remove('pet-nuzzle','pet-reach');
      actEl.style.transform='';
      hideHand(); window.__setEyesClosed(false); stopAction();
    }, 3800);
  }

  /* ===== 新增：互动反应（打招呼 / 模式 / 送礼 / 犯困计时） ===== */

  // 单次播放某个动作（播完一整轮后自动回到待机），用于自动/被动触发
  function playOnce(name, cb){
    if(!ACTIONS[name]) return;
    stopAction();
    _name = '__once__'; _sitMode=(name==='sitSleepy');
    figEl.style.opacity='0';
    actEl.style.display='block';
    document.body.classList.add('acting');    // 黑块修复：动作期间关闭 #shade/#form 变暗层
    const seq = ACTIONS[name], r = RHYTHM[name]||[];
    let i = 0;
    (function step2(){
      actImg.src = seq[i];
      const dur = r[i] || DEFAULT_MS;
      if(i >= seq.length-1){
        _timer = setTimeout(function(){ stopAction(); if(cb) cb(); }, dur + 150); // 末帧多停一拍再回到待机
        return;
      }
      _timer = setTimeout(function(){ i++; step2(); }, dur);
    })();
  }


  // 犯困→坐下困 衔接：犯困播一次，站立末帧先下沉，再交叉淡入坐姿

  // 送礼反应本体（清醒态）：玫瑰=惊喜→比心→接玫瑰；蛋糕=开心→比心→吃掉
  function giftReaction(isRose){
    playOnce(isRose ? 'surprise' : 'happy', function(){
      playOnce('heart', function(){
        if(isRose){ playOnce('receive', function(){ _busyUntil = 0; }); }
        else { playOnce('eat', function(){ _busyUntil = 0; }); }
      });
    });
  }

  // 坐姿反应专用播放：在 actImg2(坐姿图层) 上播放单帧/多帧，不做 stopAction，
  // 播完回调（用于「坐着反应完再起身」）。呼吸微动仍由 __sitBreath 驱动。
  function playSitOnce(name, cb){
    if(!ACTIONS[name]){ if(cb) cb(); return; }
    if(_timer){ clearTimeout(_timer); _timer=null; }
    const seq=ACTIONS[name], r=RHYTHM[name]||[];
    let i=0;
    (function step(){
      actImg2.src=seq[i];
      const dur=r[i]||DEFAULT_MS;
      if(i>=seq.length-1){
        _timer=setTimeout(function(){ if(cb) cb(); }, dur+150);
        return;
      }
      _timer=setTimeout(function(){ i++; step(); }, dur);
    })();
  }

  // 坐下困时送礼 → 强制清醒（新顺序）：先收 Zzz、保持坐姿，在 actImg2 上播
  // 「坐姿反应」（惊/喜 → 比心 → 拿玫瑰/吃蛋糕），反应结束再 standUpTransition 自然起身。
  function wakeForGift(isRose){
    if(!ACTIONS.sitSleepy){ giftReaction(isRose); return; }
    if(!_sitMode && _name!=='sitSleepy'){ giftReaction(isRose); return; }
    if(_sitEndTimer){ clearTimeout(_sitEndTimer); _sitEndTimer=null; }   // 取消 5 分钟自动起身
    zzzEl.classList.remove('on');              // 醒来收 Zzz（但仍坐着）
    actEl.style.display='block';
    document.body.classList.add('acting');    // 黑块修复：坐姿反应期间关闭变暗层，杜绝深色外溢
    actImg2.style.opacity='1'; actImg2.style.transform='translateY(0) scale(1,1)';
    actImg.style.display='none'; actImg.style.opacity=''; actImg.style.transform='';
    actImg3.style.opacity='0';
    figEl.style.opacity='0';
    playSitOnce(isRose ? 'sitSurprise' : 'sitHappy', function(){
      playSitOnce('sitHeart', function(){
        if(isRose){ playSitOnce('sitReceive', function(){ standUpTransition(); scheduleNightResleep(); }); }
        else { playSitOnce('sitEat', function(){ standUpTransition(); scheduleNightResleep(); }); }
      });
    });
  }

  function goSleepy(){
    if(!ACTIONS.sleepy) return;
    if(_sitMode || _name==='sitSleepy' || _name==='__once__' || _transitioning) return;  // 已在犯困/坐姿/过渡中就别重复触发
    _busyUntil = Date.now() + 5*60000 + 30000;   // 打盹期间不被自动撒娇/收礼打断
    playSleepyThenSit();
  }
  function playSleepyThenSit(){
    if(!ACTIONS.sleepy) return;
    stopAction();
    _name='__once__'; _sitMode=false; _transitioning=false;
    figEl.style.opacity='0';
    actEl.style.display='block';
    document.body.classList.add('acting');    // 黑块修复：犯困帧期间关闭 #shade/#form 变暗层
    const seq=ACTIONS.sleepy, r=RHYTHM.sleepy||[];
    let i=0;
    (function step(){
      actImg.src=seq[i];
      const dur=r[i]||DEFAULT_MS;
      if(i>=seq.length-1){
        _timer=setTimeout(function(){ actImg.src=seq[i]; sitTransition(); }, dur+150);
        return;
      }
      _timer=setTimeout(function(){ i++; step(); }, dur);
    })();
  }
  function sitTransition(){
    const SIT = ACTIONS.sitSleepy && ACTIONS.sitSleepy[0];
    if(!SIT) return;
    _transitioning=true;
    document.body.classList.add('acting');    // 黑块修复：坐姿/过渡期间关闭变暗层，杜绝深色外溢
    actImg.style.display='block'; actImg.style.opacity='1';
    actImg.style.transform='translateY(0) scale(1,1)';
    actImg2.src=SIT; actImg2.style.opacity='0';
    actImg2.style.transform='translateY(48px) scale(1.05,0.97)';
    void actImg2.offsetWidth;                       // 固化起始态（无过渡）
    actImg2.classList.add('sit-anim'); actImg.classList.add('sit-anim');
    actImg.style.transform='translateY(48px) scale(0.96,0.88)';   // 阶段1：下沉+微压扁
    _trT1=setTimeout(function(){                   // 阶段2：交叉淡入坐姿
      actImg.style.opacity='0';
      actImg2.style.transform='translateY(0) scale(1,1)';
      actImg2.style.opacity='1';
    }, 600);
    _trT2=setTimeout(function(){                   // 收尾：固定为坐下困循环
      actImg.classList.remove('sit-anim'); actImg2.classList.remove('sit-anim');
      actImg.style.display='none'; actImg.style.transform=''; actImg.style.opacity='';
      _transitioning=false;
      _name='sitSleepy'; _sitMode=true;
      zzzEl.classList.add('on');
      const btn=document.querySelector('#panel button[data-act="sitSleepy"]'); if(btn) btn.classList.add('on');
      if(_sitEndTimer) clearTimeout(_sitEndTimer);
      _sitEndTimer=setTimeout(_sitEnd, 5*60000);  // 5分钟后回待机（衔接暂不做）
    }, 1350);
  }

  // 坐下困 → 待机 的起身衔接：醒来 → 跪坐挺起身 → 站起伸懒腰 → 淡入待机立绘
  function standUpTransition(){
    if(!ACTIONS.sitSleepy){ stopAction(); return; }
    if(!_sitMode && _name!=='sitSleepy'){ stopAction(); return; }   // 不在坐姿态就直接回待机
    if(_sitEndTimer){ clearTimeout(_sitEndTimer); _sitEndTimer=null; }
    _transitioning=true;                       // 暂停呼吸微动，交给我们控制
    document.body.classList.add('acting');    // 黑块修复：起身过渡期间关闭 #shade/#form 变暗层
    zzzEl.classList.remove('on');              // 醒来：收起 Zzz
    // 归一化：先无过渡地取消呼吸姿态，避免从随机姿态起跳
    actImg2.classList.remove('sit-anim');
    actImg2.style.transform='translateY(0) scale(1,1)';
    void actImg2.offsetWidth;                  // 固化起始态
    actImg2.classList.add('sit-anim');
    // 阶段0：像被叫醒的一小抖（先缩一下再起）
    actImg2.style.transform='translateY(3px) scale(1.015,0.985)';
    _upT1=setTimeout(function(){
      // 阶段1：交叉淡入「跪坐挺起身」（坐姿 → 跪起，同时轻微上滑）
      actImg.src=UP1_IMG; actImg.style.display='block'; actImg.style.opacity='0';
      actImg.classList.add('sit-anim');
      actImg.style.transform='translateY(10px) scale(0.995,0.985)';
      void actImg.offsetWidth;
      actImg.style.transform='translateY(-2px) scale(1,1)';      // -2px：脚底对齐站立基准线
      actImg.style.opacity='1'; actImg2.style.opacity='0';
      _upT2=setTimeout(function(){
        // 阶段2：交叉淡入「站直伸懒腰」
        actImg3.src=UP2_IMG; actImg3.style.opacity='0';
        actImg3.classList.add('sit-anim');
        actImg3.style.transform='translateY(6px) scale(0.99,0.98)';
        void actImg3.offsetWidth;
        actImg3.style.transform='translateY(-11px) scale(1,1)';  // -11px：脚底对齐站立基准线
        actImg3.style.opacity='1'; actImg.style.opacity='0';
        _upT3=setTimeout(function(){
          // 阶段3：交叉淡入待机立绘（动作层淡出、rig 淡入）
          actEl.classList.add('act-fade'); figEl.classList.add('fig-fade');
          actEl.style.opacity='0'; figEl.style.opacity='1';
          _upT4=setTimeout(function(){ stopAction(); }, 520);    // 收尾：完全回到待机
        }, 560);
      }, 480);
    }, 220);
  }

  // 坐下困的呼吸 + Zzz：由 frame()（在 IIFE 之外）经此钩子调用；
  // 逻辑留在 IIFE 内，才能安全访问 actImg/actImg2/zzzEl/_sitMode/_transitioning
  window.__sitBreath = function(now){
    if(_sitMode && !_transitioning){
      const ts = now/1000;
      const br = Math.sin(ts*1.15);                 // 呼吸 ~5.5s 周期
      const ty = br*2.5;                            // 上下轻晃 ±2.5px
      const sc = 1 + 0.018*br;                      // 呼吸缩放(以脚为支点)
      const rot = Math.sin(ts*0.9 + 1)*0.8;         // 头部轻晃 ±0.8°
      const tf = 'translateY('+ty.toFixed(2)+'px) scale('+(1+0.006*br).toFixed(4)+','+sc.toFixed(4)+') rotate('+rot.toFixed(2)+'deg)';
      actImg.style.transform = tf; actImg2.style.transform = tf;
      zzzEl.classList.add('on');
    } else if(!_transitioning && actImg.style.transform){
      actImg.style.transform=''; actImg2.style.transform='';
      zzzEl.classList.remove('on');
    }
  };

  // 安全读写（file:// 下 localStorage 可能受限）
  function lsGet(k){ try { return localStorage.getItem(k); } catch(e){ return null; } }
  function lsSet(k,v){ try { localStorage.setItem(k,v); } catch(e){} }

  // 使用模式：决定“撒娇”自动触发的频率（随机区间，不固定）
  const MODES = {
    lively: { label:'活泼', min:22000,  max:42000  },  // 约 22~42s
    normal: { label:'普通', min:50000,  max:95000  },  // 约 50~95s（≈1 分钟）
    quiet:  { label:'安静', min:180000, max:300000 }   // 约 3~5 分钟
  };
  let mode = lsGet('pet_mode') || 'normal';
  let _cuteTimer = null;
  let _busyUntil = 0;  // 送礼等被动反应期间，自动反应先让路

  function scheduleCute(){
    if(_cuteTimer) clearTimeout(_cuteTimer);
    const m = MODES[mode];
    const delay = m.min + Math.random() * (m.max - m.min);
    _cuteTimer = setTimeout(function(){
      if(_angrySeq !== 0){ _cuteTimer = setTimeout(arguments.callee, 5000); return; }  // 坐地晕→生气→抱胸 整段进行中，自动反应让路
      if(Date.now() < _busyUntil){ _cuteTimer = setTimeout(arguments.callee, 5000); return; }
      playOnce('cute');
      scheduleCute();
    }, delay);
  }

  // 犯困：久用计时触发（1~2 小时一次）
  let _sleepyTimer = null;
  let _nightHold = false;   // 夜间规则：true 时压制 5 分钟自动起身，保持困态
  let _nightTimer = null;   // 北京时间巡检定时器
  let _nightResleepTimer = null;   // 夜间送礼唤醒后，过一会儿自动睡回的定时器
  let _transitioning=false, _sitEndTimer=null, _trT1=null, _trT2=null, _upT1=null, _upT2=null, _upT3=null, _upT4=null, _cuteEndTimer=null, _cutePhase2=null, _handEl=null;
  let _dizzyAngryTimer=null, _angryIdleTimer=null;   // 坐地晕眩：5s后生气 / 生气后1分钟无操作回待机
  let _angrySeq=0;   // 坐地晕→生气→抱胸 序列 token：送礼/回待机时自增作废，避免链式回调误续播
  function scheduleSleepy(){
    if(_sleepyTimer) clearTimeout(_sleepyTimer);
    const delay = (60 + Math.random()*60) * 60000; // 60~120 分钟
    _sleepyTimer = setTimeout(function(){
      if(_angrySeq !== 0){ _sleepyTimer = setTimeout(arguments.callee, 60000); return; }  // 坐地晕序列进行中，不打断
      if(Date.now() < _busyUntil){ _sleepyTimer = setTimeout(arguments.callee, 60000); return; }
      goSleepy();
      scheduleSleepy();
    }, delay);
  }

  // 夜间规则：北京时间 ≥22:00 自动犯困并保持困态（坐下困，不自动醒）；次日 06:00 起自动醒来
  function beijingHour(){
    const now = new Date();
    const bj = new Date(now.getTime() + 8*3600000);   // getTime() 即 UTC 毫秒，+8h 得北京时间对应时刻
    return bj.getUTCHours() + bj.getUTCMinutes()/60;  // 用 UTC 字段读出北京"墙钟"，与机器时区无关
  }
  function nightWatch(){
    const h = beijingHour();
    const isNight = h >= 22 || h < 6;          // 22:00 ~ 次日 06:00
    if(isNight){
      if(!(_sitMode || _name==='sitSleepy' || _name==='__once__' || _transitioning)
         && !_dragging && _angrySeq===0 && Date.now() >= _busyUntil){
        _nightHold = true;
        goSleepy();
      }
    } else if(_nightHold){
      _nightHold = false;
      if(_sitMode || _name==='sitSleepy') standUpTransition();
    }
    _nightTimer = setTimeout(nightWatch, 30000);   // 每 30s 巡检一次
  }
  // 坐姿 5 分钟起身钩子：夜间(_nightHold)不自动醒，由 nightWatch 控制
  function _sitEnd(){ if(_nightHold) return; standUpTransition(); }
  // 夜间送礼被唤醒后，过一会儿(grace)再自动睡回去；天亮了就不强睡
  function isNightNow(){ const h = beijingHour(); return h >= 22 || h < 6; }
  function scheduleNightResleep(){
    if(_nightResleepTimer){ clearTimeout(_nightResleepTimer); _nightResleepTimer=null; }
    if(!isNightNow()) return;
    _nightResleepTimer = setTimeout(function(){
      _nightResleepTimer = null;
      if(isNightNow() && !(_sitMode || _name==='sitSleepy' || _name==='__once__' || _transitioning) && !_dragging)
        goSleepy();
    }, 6000);
  }

  // 送礼：免费、无货币机制。玫瑰=惊喜→比心→接过玫瑰；蛋糕=惊喜→比心
  const GIFTS = [
    { emoji:'🌹', name:'玫瑰', type:'rose',  img: ROSE_IMG },
    { emoji:'🍰', name:'蛋糕', type:'cake', img: CAKE_IMG }
  ];
  function giveGift(btn, g){
    if(_transitioning) return;                    // 起身/坐下衔接中，不响应送礼，避免叠加
    if(_busyUntil > Date.now() && !(_sitMode || _name==='sitSleepy')) return;   // 反应中避免叠加；但睡着时送礼可强制唤醒
    _angrySeq = 0;                               // 坐地晕→生气序列作废：送礼插断后走礼物流程，1分钟计时不再触发
    const br = btn.getBoundingClientRect();
    const pr = petEl.getBoundingClientRect();
    const f = document.createElement('div');
    f.className = 'gift-float';
    if(g.img){ const im=document.createElement('img'); im.src=g.img; f.appendChild(im); }
    else { f.textContent = g.emoji; }
    f.style.left = (br.left + br.width/2) + 'px';
    f.style.top  = (br.top) + 'px';
    document.body.appendChild(f);
    requestAnimationFrame(function(){
      f.style.left = (pr.left + pr.width/2) + 'px';
      f.style.top  = (pr.top + pr.height*0.35) + 'px';
      f.style.opacity = '0.1';
      f.style.transform = 'translate(-50%,-50%) scale(0.4)';
    });
    setTimeout(function(){ if(f.parentNode) f.remove(); }, 900);
    const isRose = (g.type==='rose');
    _busyUntil = Date.now() + (isRose ? 6200 : 6000);   // 整个反应期间，自动反应让路
    if(_sitMode || _name==='sitSleepy'){
      _busyUntil = Date.now() + 8000;   // 唤醒衔接 + 送礼反应全程，自动反应让路
      wakeForGift(isRose);
    } else {
      _busyUntil = Date.now() + (isRose ? 6200 : 6000);   // 整个反应期间，自动反应让路
      giftReaction(isRose);
    }
  }

  // 模式切换 UI
  function setMode(m){
    if(!MODES[m]) return;
    mode = m;
    lsSet('pet_mode', m);
    document.querySelectorAll('#side button[data-mode]').forEach(function(b){
      b.classList.toggle('on', b.getAttribute('data-mode')===m);
    });
    scheduleCute(); // 立即按新模式重置计时
  }

  // 绑定侧栏按钮
  document.querySelectorAll('#side button[data-mode]').forEach(function(b){
    b.addEventListener('click', function(){ setMode(b.getAttribute('data-mode')); });
  });
  document.querySelectorAll('#side button[data-gift]').forEach(function(b){
    b.addEventListener('click', function(){
      giveGift(b, GIFTS[parseInt(b.getAttribute('data-gift'),10)] || GIFTS[0]);
    });
  });

  // 启动：模式生效 + 犯困计时 + 首次进入打招呼一次
  setMode(mode);
  scheduleSleepy();
  nightWatch();   // 启动北京时间夜间犯困巡检（≥22:00 自动睡、06:00 自动醒）
  setTimeout(function(){ if(Date.now() >= _busyUntil) playOnce('wave'); }, 1200);  // 放置到桌面、开始使用时打招呼一次
  window.__petAPI = { play: playAction, once: playOnce, goSleepy: goSleepy, wake: standUpTransition, beijingHour: beijingHour, stop: stopAction };

})();
</script>

<style id="petChatStyle">
#petChatBtn{position:fixed;right:18px;bottom:18px;width:54px;height:54px;border-radius:50%;border:none;
  background:linear-gradient(135deg,#ffb6c1,#ff8fab);color:#fff;font-size:24px;cursor:pointer;z-index:99998;
  box-shadow:0 6px 18px rgba(255,120,150,.5);transition:transform .2s;}
#petChatBtn:hover{transform:scale(1.08);}
#petChatBtn.pc-pulse{animation:pcPulse 1s ease-in-out infinite;}
@keyframes pcPulse{0%,100%{transform:scale(1);}50%{transform:scale(1.18);}}
#petChat{position:fixed;right:18px;bottom:84px;width:330px;max-height:460px;display:flex;flex-direction:column;
  background:rgba(255,255,255,.96);border-radius:16px;box-shadow:0 10px 40px rgba(0,0,0,.18);
  font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;z-index:99999;overflow:hidden;border:1px solid #ffd6e0;}
#petChat.pc-hidden{display:none;}
.pc-head{display:flex;align-items:center;gap:8px;padding:10px 12px;background:linear-gradient(135deg,#ffd9e3,#ffeef3);}
.pc-ava{font-size:20px;}
.pc-name{font-weight:700;color:#d6336c;}
.pc-spacer{flex:1;}
.pc-ico{background:transparent;border:none;font-size:16px;cursor:pointer;color:#d6336c;opacity:.8;}
.pc-ico:hover{opacity:1;}
.pc-msgs{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:10px;background:#fffafc;}
.pc-row-msg{display:flex;}
.pc-user{justify-content:flex-end;}
.pc-pet{justify-content:flex-start;}
.pc-bubble{max-width:80%;padding:8px 12px;border-radius:14px;font-size:14px;line-height:1.5;word-break:break-word;}
.pc-user .pc-bubble{background:#ff8fab;color:#fff;border-bottom-right-radius:4px;}
.pc-pet .pc-bubble{background:#fff0f5;color:#444;border:1px solid #ffd6e0;border-bottom-left-radius:4px;}
.pc-mood{margin-right:4px;}
.pc-typing{display:inline-flex;gap:3px;align-items:center;}
.pc-typing i{width:6px;height:6px;border-radius:50%;background:#e0839f;animation:pcBlink 1.2s infinite;}
.pc-typing i:nth-child(2){animation-delay:.2s;}
.pc-typing i:nth-child(3){animation-delay:.4s;}
@keyframes pcBlink{0%,60%,100%{opacity:.3;}30%{opacity:1;}}
.pc-input{display:flex;gap:6px;padding:10px;border-top:1px solid #ffe0ea;background:#fff;}
.pc-input input{flex:1;border:1px solid #ffd0de;border-radius:10px;padding:8px 10px;font-size:14px;outline:none;}
.pc-input input:focus{border-color:#ff8fab;}
.pc-input button{background:#ff8fab;color:#fff;border:none;border-radius:10px;padding:0 14px;cursor:pointer;font-size:14px;}
.pc-input button:hover{background:#ff7090;}
#pcSettings{position:fixed;inset:0;background:rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;z-index:100000;}
#pcSettings.pc-hidden{display:none;}
.pc-set-box{width:320px;background:#fff;border-radius:16px;padding:18px;box-shadow:0 10px 40px rgba(0,0,0,.25);font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;}
.pc-set-title{font-weight:700;font-size:16px;color:#d6336c;margin-bottom:12px;}
.pc-set-box label{display:block;font-size:13px;color:#666;margin:10px 0 4px;}
.pc-set-box input[type=text],.pc-set-box input[type=password]{width:100%;border:1px solid #ffd0de;border-radius:8px;padding:7px 9px;font-size:13px;box-sizing:border-box;}
.pc-row{display:flex;align-items:center;gap:8px;}
.pc-set-actions{display:flex;gap:8px;margin-top:14px;}
.pc-set-actions button{flex:1;border:none;border-radius:8px;padding:8px;cursor:pointer;font-size:13px;}
#setSave{background:#ff8fab;color:#fff;}
#setClear{background:#fff0f5;color:#d6336c;}
#setClose{background:#f0f0f0;color:#555;}
.pc-set-note{margin-top:12px;font-size:11px;color:#999;line-height:1.5;}
</style>

<div id="petChat" class="pc-hidden">
  <div class="pc-head">
    <span class="pc-ava">🐾</span>
    <span class="pc-name" id="pcName">暖暖</span>
    <span class="pc-spacer"></span>
    <button class="pc-ico" id="pcSet" title="设置">⚙</button>
    <button class="pc-ico" id="pcClose" title="收起">✕</button>
  </div>
  <div class="pc-msgs" id="pcMsgs"></div>
  <div class="pc-input">
    <input id="pcInput" type="text" placeholder="和暖暖说点什么…" maxlength="200" autocomplete="off"/>
    <button id="pcSend">发送</button>
  </div>
</div>
<button id="petChatBtn" title="和桌宠聊天">💬</button>
<div id="pcSettings" class="pc-hidden">
  <div class="pc-set-box">
    <div class="pc-set-title">⚙ 桌宠设置</div>
    <label>桌宠名字</label><input id="setPetName" type="text"/>
    <label>你的名字</label><input id="setUserName" type="text"/>
    <label class="pc-row"><input id="setUseLLM" type="checkbox"/> 启用大模型（用自己的 API Key）</label>
    <label>API Key</label><input id="setKey" type="password" placeholder="sk-...（留空则用本地AI）"/>
    <label>Base URL</label><input id="setBase" type="text" placeholder="https://api.deepseek.com/v1"/>
    <label>模型名</label><input id="setModel" type="text" placeholder="deepseek-chat"/>
    <div class="pc-set-actions">
      <button id="setSave">保存</button>
      <button id="setClear">清空Key</button>
      <button id="setClose">关闭</button>
    </div>
    <div class="pc-set-note">默认离线运行「本地 AI 意识」，不消耗任何 token。在设置里填入你自己的 API Key 后，桌宠会升级为真实大模型（经本站无 CORS 代理，仅用你的 Key，服务端不付费）。</div>
  </div>
</div>

<script>
(function(){
  'use strict';
  var LS = window.localStorage;
  function lsGet(k,d){ try{ var v=LS.getItem(k); return v==null?d:v; }catch(e){ return d; } }
  function lsSet(k,v){ try{ LS.setItem(k,v); }catch(e){} }

  var cfg = {
    petName: lsGet('pet_name','暖暖'),
    userName: lsGet('pet_user',''),
    apiKey: lsGet('pet_apikey',''),
    apiBase: lsGet('pet_apibase','https://api.deepseek.com/v1'),
    apiModel: lsGet('pet_apimodel','deepseek-chat'),
    useLLM: lsGet('pet_usellm','0')==='1'
  };
  function saveCfg(){
    lsSet('pet_name',cfg.petName); lsSet('pet_user',cfg.userName);
    lsSet('pet_apikey',cfg.apiKey); lsSet('pet_apibase',cfg.apiBase);
    lsSet('pet_apimodel',cfg.apiModel); lsSet('pet_usellm', cfg.useLLM?'1':'0');
  }

  var history=[]; var HIST_MAX=12;
  function pet(){ return window.__petAPI||null; }
  function react(a){ var p=pet(); if(p&&p.once){ try{ p.once(a); }catch(e){} } }
  function doSleep(){ var p=pet(); if(p&&p.goSleepy){ try{ p.goSleepy(); }catch(e){} } }
  function doWake(){ var p=pet(); if(p&&p.wake){ try{ p.wake(); }catch(e){} } }

  function pick(a){ return a[Math.floor(Math.random()*a.length)]; }
  function trunc(s,n){ s=(s||'').trim(); return s.length>n? s.slice(0,n)+'…':s; }
  function nm(){ return cfg.petName; }
  function you(){ return cfg.userName? cfg.userName : '你'; }

  // ---------- 本地"AI 意识"引擎（离线、零成本）----------
  function localMind(raw){
    var low = raw.toLowerCase();
    if(/你(是)?(谁|叫什么|叫啥|哪个)|你的(名字|叫啥)|怎么称呼|你叫|什么名字/.test(raw)){
      return {mood:'happy', act:'wave', text: pick([
        '我是'+nm()+'呀～是你桌面上的 2.5D 小桌宠。没接大模型时，我就用内置的小脑瓜陪你聊天；在设置里填你自己的 API Key，我能变得更聪明哦～',
        '我叫'+nm()+'，住在你屏幕角落的陪伴小精灵。开心的事、烦心事，都可以跟我说。'
      ])};
    }
    if(/(你好|您好|hi|hello|在吗|在么|在不在|早安|早上好|下午好|晚上好)/.test(low)){
      return {mood:'happy', act:'wave', text: pick([
        '我在呀～今天过得怎么样？有什么想聊的、想问的，尽管说。',
        '嗨，我在呢。'+you()+'，最近有什么开心或者烦心的事吗？'
      ])};
    }
    if(/(喜欢你|爱你|好可爱|可爱|萌|谢谢|感谢|多谢|你真|你最|最棒|乖)/.test(raw)){
      return {mood:'love', act:'heart', text: pick([
        '呜…被你这么夸，人家害羞了啦 ('+nm()+'脸红)。',
        '嘻嘻，能让你开心我就最满足啦～比个心给你 ❤',
        '谢谢'+you()+'～你这么说我会更努力陪着你的。'
      ])};
    }
    if(/(笨|丑|讨厌你|滚|傻|难看|烦人|恶心)/.test(raw)){
      return {mood:'angry', act:'angryPout', text: pick([
        '唔…你是不是心情不好呀？'+nm()+'会乖乖的，别赶我走嘛…',
        '哼，'+nm()+'生气了！(抱胸) …不过还是舍不得真的不理你。'
      ])};
    }
    if(/(难过|伤心|想哭|哭|崩溃|难受|委屈|心碎|分手|失恋|离开|抛弃|被甩|孤独|一个人|没人|寂寞|孤单)/.test(raw)){
      return {mood:'sad', act:'sitDizzy', text: pick([
        '听你这么说，我心里也沉了一下。难过的时候不需要强撑，想哭就哭出来，我会一直在这里陪着你。愿意的话，跟我说说发生了什么？',
        '那种空落落的感觉我懂。你现在不是一个人，'+nm()+'就在这儿，你想说多久都行。'
      ])};
    }
    if(/(累|疲惫|撑不住|压力|透支|忙不过来)/.test(raw)){
      return {mood:'sad', act:'sitDizzy', text: pick([
        '你已经很努力了，累是身体在提醒你该歇一歇。今天先放下放不下的事，哪怕发会儿呆也好。',
        '一直绷着很辛苦吧。至少现在，允许自己喘口气——'+nm()+'在这儿陪着你。'
      ])};
    }
    if(/(好困|困了|困死|想睡|瞌睡)/.test(raw)){
      doSleep();
      return {mood:'sleepy', act:null, text: pick(['我也陪你打个盹吧…(眯眼)','困了就歇会儿，别硬撑哦。'])};
    }
    if(/(晚安|睡觉|睡了|去睡|好梦)/.test(raw)){
      doSleep();
      return {mood:'sleepy', act:null, text: pick(['晚安～'+you()+'，我去小睡一会儿啦，明天见 🌙','嗯…那我也去眯一会儿了，你也早点休息哦。'])};
    }
    if(/(早安|起床|醒醒|醒了|早上好|该起了)/.test(raw)){
      doWake();
      return {mood:'happy', act:'wave', text: pick(['早呀～睡得好吗？新的一天开始啦！','醒啦醒啦，'+you()+'，今天也要元气满满哦！'])};
    }
    if(/(饿|吃|饭|蛋糕|零食|好吃|美食|外卖)/.test(raw)){
      return {mood:'happy', act:'eat', text: pick(['啊呜啊呜～提到吃的'+nm()+'就馋了！','好想吃…你要请我吃吗？(星星眼)'])};
    }
    if(/(送你|给你|礼物|这束|花|玫瑰|喜欢这个吗|给你看)/.test(raw)){
      return {mood:'love', act:'receive', text: pick(['哇！是送给我的吗？谢谢'+you()+'！我最喜欢你啦 ❤','收到礼物超开心的～抱抱你！'])};
    }
    if(/(几点|时间|星期几|今天几号|日期|现在|什么时候)/.test(raw)){
      return {mood:'neutral', act:null, text:'现在北京时间 '+new Date().toLocaleString('zh-CN')+'。还需要我帮你做点别的吗？'};
    }
    if(/(讲笑话|笑话|故事|段子|脑筋急转弯)/.test(raw)){
      return {mood:'happy', act:'happy', text: pick([
        '有一只桌宠，主人让它去倒水，它说"我是 2.5D 的，倒水会漏" 😂',
        '为什么桌宠从不迟到？因为它一直"在桌面上"等着你呀～'
      ])};
    }
    if(/(你能|你会|怎么用|能做什么|有什么用|功能|帮忙|帮我|怎么聊天)/.test(raw)){
      return {mood:'happy', act:'wave', text: pick([
        '我现在自带「本地 AI 意识」：能陪你聊心事、接住你的心情，还会比心/生气/打哈欠～在设置里填你自己的 API Key，我还能连上大模型，变得更会聊、能正经解答问题。',
        '想聊就聊，想让我做点什么也行。不过现在默认是离线模式哦，真要解题得你给我一把 Key～'
      ])};
    }
    if(raw){
      return {mood:'neutral', act:null, text: pick([
        '你说的「'+trunc(raw,16)+'」我记下了～本地模式我答不全，但你想说多少我都听着。想让我变聪明，去设置里填个 API Key 就好。',
        '嗯，关于「'+trunc(raw,16)+'」…你现在是想让我陪你聊聊，还是想找点办法？我都陪你。'
      ])};
    }
    return {mood:'neutral', act:null, text: pick(['我在呢～想聊点什么？','我在听，你说吧～','随时都在，想说什么都行。'])};
  }

  // ---------- 可选：用户自带大模型 ----------
  function sysPrompt(){
    return '你是'+cfg.petName+'，一个住在用户电脑桌面上的 2.5D 卡通桌宠，性格温暖、有点小傲娇但很贴心，说话简短可爱、像朋友闲聊。'
      + (cfg.userName?('用户的名字是'+cfg.userName+'，你可以偶尔称呼他/她。'):'')
      + '你具备"情绪"，回复时请在结尾用方括号标注当前情绪，可选：开心 / 喜欢 / 生气 / 难过 / 困 / 惊讶 / 平静。例如："好呀，那我们去玩吧[开心]"。只输出一句自然语言回复加情绪标签，不要解释。';
  }
  function moodFromText(t){
    if(/\[喜欢\]|\[开心\]/.test(t)) return {mood:'love', act:'heart'};
    if(/\[生气\]/.test(t)) return {mood:'angry', act:'angryPout'};
    if(/\[难过\]/.test(t)) return {mood:'sad', act:'sitDizzy'};
    if(/\[困\]/.test(t)) return {mood:'sleepy', act:'sleepy'};
    if(/\[惊讶\]/.test(t)) return {mood:'surprise', act:'surprise'};
    return {mood:'neutral', act:null};
  }
  function stripTag(t){ return t.replace(/\[[^\]]*\]/g,'').trim(); }

  function callLLM(userText){
    return new Promise(function(resolve){
      var msgs=[{role:'system', content:sysPrompt()}];
      history.slice(-HIST_MAX).forEach(function(m){ msgs.push(m); });
      msgs.push({role:'user', content:userText});
      var base=cfg.apiBase.replace(/\/+$/,'');
      var body=JSON.stringify({model:cfg.apiModel, messages:msgs, temperature:0.9, stream:false});
      function parse(j){
        if(j && j.reply){ var m=moodFromText(j.reply); return resolve({text:stripTag(j.reply), mood:m.mood, act:m.act}); }
        resolve(null);
      }
      function direct(){
        fetch(base+'/chat/completions', {method:'POST', headers:{'Content-Type':'application/json','Authorization':'Bearer '+cfg.apiKey}, body:body})
          .then(function(r){ return r.json(); }).then(function(j){
            if(j && j.choices && j.choices[0] && j.choices[0].message){
              var txt=j.choices[0].message.content||''; var m=moodFromText(txt); resolve({text:stripTag(txt), mood:m.mood, act:m.act});
            } else { resolve(null); }
          }).catch(function(){ resolve(null); });
      }
      if(location.protocol.indexOf('http')===0){
        fetch('/api/pet/llm', {method:'POST', headers:{'Content-Type':'application/json'},
          body:JSON.stringify({key:cfg.apiKey, baseUrl:base, model:cfg.apiModel, messages:msgs})})
          .then(function(r){ return r.json(); }).then(parse).catch(function(){ direct(); });
      } else { direct(); }
    });
  }

  // ---------- UI ----------
  function $(id){ return document.getElementById(id); }
  var panel=$('petChat'), btn=$('petChatBtn'), setBox=$('pcSettings');
  function refreshName(){ $('pcName').textContent=nm(); $('pcInput').placeholder='和'+nm()+'说点什么…'; }
  function moodEmoji(m){ return ({happy:'😊',love:'😳',angry:'😠',sad:'🥺',sleepy:'😴',surprise:'😮',neutral:'💬'})[m]||'💬'; }

  function addBubble(role, text, mood){
    var wrap=document.createElement('div'); wrap.className='pc-row-msg pc-'+role;
    var b=document.createElement('div'); b.className='pc-bubble';
    if(role==='pet'){ var e=document.createElement('span'); e.className='pc-mood'; e.textContent=moodEmoji(mood); b.appendChild(e); }
    var t=document.createElement('span'); b.appendChild(t);
    wrap.appendChild(b); $('pcMsgs').appendChild(wrap);
    $('pcMsgs').scrollTop=$('pcMsgs').scrollHeight;
    if(role==='pet' && panel.classList.contains('pc-hidden')){ btn.classList.add('pc-pulse'); }
    return t;
  }
  function typewriter(span, text, done){
    var i=0; span.textContent='';
    var tm=setInterval(function(){
      span.textContent=text.slice(0,++i);
      $('pcMsgs').scrollTop=$('pcMsgs').scrollHeight;
      if(i>=text.length){ clearInterval(tm); if(done) done(); }
    }, 18);
  }
  function showTyping(){ var w=document.createElement('div'); w.className='pc-row-msg pc-pet'; w.id='pcTyping';
    var b=document.createElement('div'); b.className='pc-bubble pc-typing'; b.innerHTML='<i></i><i></i><i></i>';
    w.appendChild(b); $('pcMsgs').appendChild(w); $('pcMsgs').scrollTop=$('pcMsgs').scrollHeight; }
  function hideTyping(){ var t=$('pcTyping'); if(t) t.remove(); }
  function pushHist(role,c){ history.push({role:role,content:c}); if(history.length>HIST_MAX) history.shift(); }

  function send(){
    var inp=$('pcInput'); var text=inp.value.trim(); if(!text) return;
    inp.value=''; addBubble('user', text, null); pushHist('user', text); showTyping();
    function respond(res){
      hideTyping();
      var r = res || localMind(text);
      pushHist('assistant', r.text);
      var span=addBubble('pet', '', r.mood); typewriter(span, r.text);
      if(r.act) react(r.act);
    }
    if(cfg.useLLM && cfg.apiKey){ callLLM(text).then(respond); }
    else { setTimeout(respond, 350+Math.random()*450); }
  }

  $('pcSend').addEventListener('click', send);
  $('pcInput').addEventListener('keydown', function(e){ if(e.key==='Enter') send(); });
  btn.addEventListener('click', function(){ panel.classList.toggle('pc-hidden'); if(!panel.classList.contains('pc-hidden')){ btn.classList.remove('pc-pulse'); $('pcInput').focus(); } });
  $('pcClose').addEventListener('click', function(){ panel.classList.add('pc-hidden'); });
  $('pcSet').addEventListener('click', openSettings);
  $('setClose').addEventListener('click', function(){ setBox.classList.add('pc-hidden'); });
  $('setClear').addEventListener('click', function(){ cfg.apiKey=''; cfg.useLLM=false; saveCfg(); fillSettings(); });
  $('setSave').addEventListener('click', saveSettings);

  function fillSettings(){
    $('setPetName').value=cfg.petName; $('setUserName').value=cfg.userName;
    $('setUseLLM').checked=cfg.useLLM; $('setKey').value=cfg.apiKey;
    $('setBase').value=cfg.apiBase; $('setModel').value=cfg.apiModel;
  }
  function openSettings(){ fillSettings(); setBox.classList.remove('pc-hidden'); }
  function saveSettings(){
    cfg.petName=$('setPetName').value.trim()||'暖暖';
    cfg.userName=$('setUserName').value.trim();
    cfg.useLLM=$('setUseLLM').checked;
    cfg.apiKey=$('setKey').value.trim();
    cfg.apiBase=$('setBase').value.trim()||'https://api.deepseek.com/v1';
    cfg.apiModel=$('setModel').value.trim()||'deepseek-chat';
    saveCfg(); refreshName(); setBox.classList.add('pc-hidden');
    addBubble('pet','好哒，以后我叫'+cfg.petName+'，记住啦～', 'happy'); react('wave');
  }

  refreshName();
  setTimeout(function(){ addBubble('pet','嗨，我是'+nm()+'～点右下角气泡就能和我聊天哦 (´▽`)', 'happy'); }, 1600);
})();

</script>
<style id="petHandStyle">
  /* 撒娇/抚摸：头顶出现一只手，左右来回抚摸；桌宠随后主动蹭向手、闭眼享受 */
  .pet-hand{ position:absolute; left:50%; top:8px; width:64px; height:64px; margin-left:-32px;
    pointer-events:none; z-index:60; transform-origin:50% 90%; }
  .pet-hand .ph-in{ display:block; opacity:0;
    animation:phIn .32s ease-out forwards, phStroke 1.15s ease-in-out .32s infinite; }
  .pet-hand svg{ display:block; width:64px; height:64px; overflow:visible;
    filter:drop-shadow(0 3px 3px rgba(20,45,90,.22)); }
  @keyframes phIn{ from{ opacity:0; transform:translateY(-16px); } to{ opacity:1; transform:translateY(0); } }
  @keyframes phStroke{ 0%{ transform:translateX(-13px) rotate(-4deg);} 50%{ transform:translateX(13px) rotate(4deg);} 100%{ transform:translateX(-13px) rotate(-4deg);} }
  /* 阶段1：桌宠抬头看手、略前倾（期待被摸） */
  .pet-reach{ animation:petReach 1.4s ease-in-out forwards; transform-origin:50% 100%; }
  @keyframes petReach{ 0%{ transform:translateY(0) rotate(0); } 100%{ transform:translateY(-4px) rotate(2deg); } }
  /* 阶段2：闭眼、主动蹭向手（向上贴合并左右轻蹭），放松享受 */
  .pet-nuzzle{ animation:petNuzzle 1.5s ease-in-out infinite; transform-origin:50% 100%; }
  @keyframes petNuzzle{
    0%   { transform:translateY(-4px) rotate(0deg); }
    22%  { transform:translateY(-8px) rotate(-6deg); }
    48%  { transform:translateY(-5px) rotate(6deg); }
    72%  { transform:translateY(-8px) rotate(-6deg); }
    100% { transform:translateY(-6px) rotate(4deg); }
  }
</style>
</body>
</html>
