',
        'data:image/png;base64,',
        'data:image/png;base64,'
  ];
  const TAIL_MS = [90, 115, 115, 115, 115, 115, 115, 190];
  let _tailTimer = null;
  function isSitSleepy(){
    return (_sitMode || _name==='sitSleepy') && !_transitioning;
  }
  function sitLayer(){
    return (actImg2 && actImg2.style.opacity==='1' && actImg2.getAttribute('src')) ? actImg2 : actImg;
  }
  function playTailWag(){
    if(!isSitSleepy() || !ACTIONS.sitSleepy || !ACTIONS.sitSleepy[0]) return;
    if(_tailTimer){ clearTimeout(_tailTimer); _tailTimer=null; }   // 连点则重头摇一次
    const SIT = ACTIONS.sitSleepy[0];
    const seq = [SIT].concat(TAIL_FRAMES, [SIT]);   // 首尾都是原版坐下困帧
    const im = sitLayer();
    let i = 0;
    (function step(){
      if(!isSitSleepy()){ _tailTimer=null; return; }  // 已起身/切动作：立刻停，不再改 src
      im.src = seq[i];
      if(i >= seq.length-1){ _tailTimer=null; return; }
      _tailTimer = setTimeout(function(){ i++; step(); }, TAIL_MS[i]||90);
    })();
  }

  /* ===== 新增：摸头撒娇（双击触发）=====
     保持原有模型与实现方式：不切换任何动作帧，沿用待机立绘，
     由上方 RAF 锁闭修正版 #lid 闭眼层得到「只留睫毛的两眼全闭」，
     再叠加 CSS 小手 / 腮红 / 爱心，并让 #rig 极小幅度蹭动。
     注意：面板「撒娇」按钮与自动撒娇仍播原版 cute 动作，二者场景不同。 */
  let _patTimer = null;
  function endPat(){
    if(_tailTimer){ clearTimeout(_tailTimer); _tailTimer=null; }   // 动作切换时收掉尾巴动画
    if(_patTimer){ clearTimeout(_patTimer); _patTimer=null; }
    const L = document.getElementById('patLayer');
    if(L){
      L.classList.remove('on');
      L.querySelectorAll('.pet-heart').forEach(function(h){ h.remove(); });
    }
    window.__patActive = false;
    window.__patNuzzle = null;
  }
  function spawnHearts(){
    const L = document.getElementById('patLayer');
    if(!L) return;
    [{x:52,y:96,d:0},{x:158,y:86,d:280},{x:62,y:76,d:620},{x:150,y:102,d:940}].forEach(function(c){
      const s=document.createElement('span');
      s.className='pet-heart'; s.textContent='♥';
      s.style.left=c.x+'px'; s.style.top=c.y+'px'; s.style.animationDelay=c.d+'ms';
      L.appendChild(s);
    });
  }
  function playPat(){
    endPat();
    stopAction();                       // 收掉任何动作帧，回到待机立绘（内部也会 endPat，无害）
    _busyUntil = Date.now() + 3600;     // 撒娇期间自动反应让路
    const L = document.getElementById('patLayer');
    window.__patActive = true;          // RAF：两眼全闭
    window.__patNuzzle = { t: performance.now() };
    if(L){ L.classList.add('on'); spawnHearts(); }
    _patTimer = setTimeout(endPat, 3400);
  }

  /* ===== 交互区分：拖拽 / 单击 / 双击 =====
     - 拖拽：pointermove 超过 4px 阈值 → 只移动，绝不触发任何点击动作
     - 单击：等 DOUBLE_GAP 确认没有第二次点击 → 原有打招呼 wave
     - 双击：窗口内出现第二次点击 → 取消待执行的单击，改播摸头撒娇
     故双击绝不会被误识别为两次单击；拖拽与点击判定互不相干。 */
  const DOUBLE_GAP = 280;
  let _downX=0,_downY=0,_moved=false,_pressed=false,_clickCount=0,_clickTimer=null;
  petEl.addEventListener('pointerdown', function(e){
    _downX=e.clientX; _downY=e.clientY; _moved=false; _pressed=true;
  });
  petEl.addEventListener('pointermove', function(e){
    if(!_pressed) return;               // 未按下时的悬停移动不参与判定
    if(Math.abs(e.clientX-_downX)>4 || Math.abs(e.clientY-_downY)>4) _moved=true;
  });
  petEl.addEventListener('pointerup', function(e){
    if(!_pressed) return;
    _pressed=false;
    if(_moved){                         // 拖拽结束：清空一切待判定单击
      _moved=false; _clickCount=0;
      if(_clickTimer){ clearTimeout(_clickTimer); _clickTimer=null; }
      return;
    }
    if(e.button && e.button!==0) return;   // 仅左键
    _clickCount++;
    if(_clickCount===1){
      _clickTimer=setTimeout(function(){
        _clickCount=0; _clickTimer=null;
        if(isSitSleepy()) playTailWag();  // 坐下困：保持坐姿，只轻摇尾巴
        else playOnce('wave');            // 其余状态：单击 = 原有打招呼
      }, DOUBLE_GAP);
    }else{
      if(_clickTimer){ clearTimeout(_clickTimer); _clickTimer=null; }
      _clickCount=0;
      if(isSitSleepy()) playTailWag();    // 坐下困：双击同样只摇尾巴，不摸头、不站起
      else playPat();                     // 其余状态：双击 = 摸头撒娇
    }
  });
  petEl.addEventListener('pointercancel', function(){
    _pressed=false; _moved=false; _clickCount=0;
    if(_clickTimer){ clearTimeout(_clickTimer); _clickTimer=null; }
  });

  /* ===== 新增：互动反应（打招呼 / 模式 / 送礼 / 犯困计时） ===== */

  // 单次播放某个动作（播完一整轮后自动回到待机），用于自动/被动触发
  function playOnce(name, cb){
    if(!ACTIONS[name]) return;
    stopAction();
    _name = '__once__'; _sitMode=(name==='sitSleepy');
    figEl.style.opacity='0';
    actEl.style.display='block';
    document.body.classList.add('acting');    // 黑块修复：动作期间关闭 #shade/#form 变暗层
    const seq = ACTIONS[name], r = RHYTHM[name]||[];
    let i = 0;
    (function step2(){
      actImg.src = seq[i];
      const dur = r[i] || DEFAULT_MS;
      if(i >= seq.length-1){
        _timer = setTimeout(function(){ stopAction(); if(cb) cb(); }, dur + 150); // 末帧多停一拍再回到待机
        return;
      }
      _timer = setTimeout(function(){ i++; step2(); }, dur);
    })();
  }


  // 犯困→坐下困 衔接：犯困播一次，站立末帧先下沉，再交叉淡入坐姿

  // 送礼反应本体（清醒态）：玫瑰=惊喜→比心→接玫瑰；蛋糕=开心→比心→吃掉
  function giftReaction(isRose){
    playOnce(isRose ? 'surprise' : 'happy', function(){
      playOnce('heart', function(){
        if(isRose){ playOnce('receive', function(){ _busyUntil = 0; }); }
        else { playOnce('eat', function(){ _busyUntil = 0; }); }
      });
    });
  }

  // 坐姿反应专用播放：在 actImg2(坐姿图层) 上播放单帧/多帧，不做 stopAction，
  // 播完回调（用于「坐着反应完再起身」）。呼吸微动仍由 __sitBreath 驱动。
  function playSitOnce(name, cb){
    if(!ACTIONS[name]){ if(cb) cb(); return; }
    if(_timer){ clearTimeout(_timer); _timer=null; }
    const seq=ACTIONS[name], r=RHYTHM[name]||[];
    let i=0;
    (function step(){
      actImg2.src=seq[i];
      const dur=r[i]||DEFAULT_MS;
      if(i>=seq.length-1){
        _timer=setTimeout(function(){ if(cb) cb(); }, dur+150);
        return;
      }
      _timer=setTimeout(function(){ i++; step(); }, dur);
    })();
  }

  // 坐下困时送礼 → 强制清醒（新顺序）：先收 Zzz、保持坐姿，在 actImg2 上播
  // 「坐姿反应」（惊/喜 → 比心 → 拿玫瑰/吃蛋糕），反应结束再 standUpTransition 自然起身。
  function wakeForGift(isRose){
    if(!ACTIONS.sitSleepy){ giftReaction(isRose); return; }
    if(!_sitMode && _name!=='sitSleepy'){ giftReaction(isRose); return; }
    if(_sitEndTimer){ clearTimeout(_sitEndTimer); _sitEndTimer=null; }   // 取消 5 分钟自动起身
    zzzEl.classList.remove('on');              // 醒来收 Zzz（但仍坐着）
    actEl.style.display='block';
    document.body.classList.add('acting');    // 黑块修复：坐姿反应期间关闭变暗层，杜绝深色外溢
    actImg2.style.opacity='1'; actImg2.style.transform='translateY(0) scale(1,1)';
    actImg.style.display='none'; actImg.style.opacity=''; actImg.style.transform='';
    actImg3.style.opacity='0';
    figEl.style.opacity='0';
    playSitOnce(isRose ? 'sitSurprise' : 'sitHappy', function(){
      playSitOnce('sitHeart', function(){
        if(isRose){ playSitOnce('sitReceive', function(){ standUpTransition(); }); }
        else { playSitOnce('sitEat', function(){ standUpTransition(); }); }
      });
    });
  }

  function goSleepy(){
    if(!ACTIONS.sleepy) return;
    _busyUntil = Date.now() + 5*60000 + 30000;   // 打盹期间不被自动撒娇/收礼打断
    playSleepyThenSit();
  }
  function playSleepyThenSit(){
    if(!ACTIONS.sleepy) return;
    stopAction();
    _name='__once__'; _sitMode=false; _transitioning=false;
    figEl.style.opacity='0';
    actEl.style.display='block';
    document.body.classList.add('acting');    // 黑块修复：犯困帧期间关闭 #shade/#form 变暗层
    const seq=ACTIONS.sleepy, r=RHYTHM.sleepy||[];
    let i=0;
    (function step(){
      actImg.src=seq[i];
      const dur=r[i]||DEFAULT_MS;
      if(i>=seq.length-1){
        _timer=setTimeout(function(){ actImg.src=seq[i]; sitTransition(); }, dur+150);
        return;
      }
      _timer=setTimeout(function(){ i++; step(); }, dur);
    })();
  }
  function sitTransition(){
    const SIT = ACTIONS.sitSleepy && ACTIONS.sitSleepy[0];
    if(!SIT) return;
    _transitioning=true;
    document.body.classList.add('acting');    // 黑块修复：坐姿/过渡期间关闭变暗层，杜绝深色外溢
    actImg.style.display='block'; actImg.style.opacity='1';
    actImg.style.transform='translateY(0) scale(1,1)';
    actImg2.src=SIT; actImg2.style.opacity='0';
    actImg2.style.transform='translateY(48px) scale(1.05,0.97)';
    void actImg2.offsetWidth;                       // 固化起始态（无过渡）
    actImg2.classList.add('sit-anim'); actImg.classList.add('sit-anim');
    actImg.style.transform='translateY(48px) scale(0.96,0.88)';   // 阶段1：下沉+微压扁
    _trT1=setTimeout(function(){                   // 阶段2：交叉淡入坐姿
      actImg.style.opacity='0';
      actImg2.style.transform='translateY(0) scale(1,1)';
      actImg2.style.opacity='1';
    }, 600);
    _trT2=setTimeout(function(){                   // 收尾：固定为坐下困循环
      actImg.classList.remove('sit-anim'); actImg2.classList.remove('sit-anim');
      actImg.style.display='none'; actImg.style.transform=''; actImg.style.opacity='';
      _transitioning=false;
      _name='sitSleepy'; _sitMode=true;
      zzzEl.classList.add('on');
      const btn=document.querySelector('#panel button[data-act="sitSleepy"]'); if(btn) btn.classList.add('on');
      if(_sitEndTimer) clearTimeout(_sitEndTimer);
      _sitEndTimer=setTimeout(function(){ standUpTransition(); }, 5*60000);  // 5分钟后回待机（衔接暂不做）
    }, 1350);
  }

  // 坐下困 → 待机 的起身衔接：醒来 → 跪坐挺起身 → 站起伸懒腰 → 淡入待机立绘
  function standUpTransition(){
    if(!ACTIONS.sitSleepy){ stopAction(); return; }
    if(!_sitMode && _name!=='sitSleepy'){ stopAction(); return; }   // 不在坐姿态就直接回待机
    if(_sitEndTimer){ clearTimeout(_sitEndTimer); _sitEndTimer=null; }
    _transitioning=true;                       // 暂停呼吸微动，交给我们控制
    document.body.classList.add('acting');    // 黑块修复：起身过渡期间关闭 #shade/#form 变暗层
    zzzEl.classList.remove('on');              // 醒来：收起 Zzz
    // 归一化：先无过渡地取消呼吸姿态，避免从随机姿态起跳
    actImg2.classList.remove('sit-anim');
    actImg2.style.transform='translateY(0) scale(1,1)';
    void actImg2.offsetWidth;                  // 固化起始态
    actImg2.classList.add('sit-anim');
    // 阶段0：像被叫醒的一小抖（先缩一下再起）
    actImg2.style.transform='translateY(3px) scale(1.015,0.985)';
    _upT1=setTimeout(function(){
      // 阶段1：交叉淡入「跪坐挺起身」（坐姿 → 跪起，同时轻微上滑）
      actImg.src=UP1_IMG; actImg.style.display='block'; actImg.style.opacity='0';
      actImg.classList.add('sit-anim');
      actImg.style.transform='translateY(10px) scale(0.995,0.985)';
      void actImg.offsetWidth;
      actImg.style.transform='translateY(-2px) scale(1,1)';      // -2px：脚底对齐站立基准线
      actImg.style.opacity='1'; actImg2.style.opacity='0';
      _upT2=setTimeout(function(){
        // 阶段2：交叉淡入「站直伸懒腰」
        actImg3.src=UP2_IMG; actImg3.style.opacity='0';
        actImg3.classList.add('sit-anim');
        actImg3.style.transform='translateY(6px) scale(0.99,0.98)';
        void actImg3.offsetWidth;
        actImg3.style.transform='translateY(-11px) scale(1,1)';  // -11px：脚底对齐站立基准线
        actImg3.style.opacity='1'; actImg.style.opacity='0';
        _upT3=setTimeout(function(){
          // 阶段3：交叉淡入待机立绘（动作层淡出、rig 淡入）
          actEl.classList.add('act-fade'); figEl.classList.add('fig-fade');
          actEl.style.opacity='0'; figEl.style.opacity='1';
          _upT4=setTimeout(function(){ stopAction(); }, 520);    // 收尾：完全回到待机
        }, 560);
      }, 480);
    }, 220);
  }

  // 坐下困的呼吸 + Zzz：由 frame()（在 IIFE 之外）经此钩子调用；
  // 逻辑留在 IIFE 内，才能安全访问 actImg/actImg2/zzzEl/_sitMode/_transitioning
  window.__sitBreath = function(now){
    if(_sitMode && !_transitioning){
      const ts = now/1000;
      const br = Math.sin(ts*1.15);                 // 呼吸 ~5.5s 周期
      const ty = br*2.5;                            // 上下轻晃 ±2.5px
      const sc = 1 + 0.018*br;                      // 呼吸缩放(以脚为支点)
      const rot = Math.sin(ts*0.9 + 1)*0.8;         // 头部轻晃 ±0.8°
      const tf = 'translateY('+ty.toFixed(2)+'px) scale('+(1+0.006*br).toFixed(4)+','+sc.toFixed(4)+') rotate('+rot.toFixed(2)+'deg)';
      actImg.style.transform = tf; actImg2.style.transform = tf;
      zzzEl.classList.add('on');
    } else if(!_transitioning && actImg.style.transform){
      actImg.style.transform=''; actImg2.style.transform='';
      zzzEl.classList.remove('on');
    }
  };

  // 安全读写（file:// 下 localStorage 可能受限）
  function lsGet(k){ try { return localStorage.getItem(k); } catch(e){ return null; } }
  function lsSet(k,v){ try { localStorage.setItem(k,v); } catch(e){} }

  // 使用模式：决定“撒娇”自动触发的频率（随机区间，不固定）
  const MODES = {
    lively: { label:'活泼', min:22000,  max:42000  },  // 约 22~42s
    normal: { label:'普通', min:50000,  max:95000  },  // 约 50~95s（≈1 分钟）
    quiet:  { label:'安静', min:180000, max:300000 }   // 约 3~5 分钟
  };
  let mode = lsGet('pet_mode') || 'normal';
  let _cuteTimer = null;
  let _busyUntil = 0;  // 送礼等被动反应期间，自动反应先让路

  function scheduleCute(){
    if(_cuteTimer) clearTimeout(_cuteTimer);
    const m = MODES[mode];
    const delay = m.min + Math.random() * (m.max - m.min);
    _cuteTimer = setTimeout(function(){
      if(_angrySeq !== 0){ _cuteTimer = setTimeout(arguments.callee, 5000); return; }  // 坐地晕→生气→抱胸 整段进行中，自动反应让路
      if(Date.now() < _busyUntil){ _cuteTimer = setTimeout(arguments.callee, 5000); return; }
      playOnce('cute');
      scheduleCute();
    }, delay);
  }

  // 犯困：久用计时触发（1~2 小时一次）
  let _sleepyTimer = null;
  let _transitioning=false, _sitEndTimer=null, _trT1=null, _trT2=null, _upT1=null, _upT2=null, _upT3=null, _upT4=null;
  let _dizzyAngryTimer=null, _angryIdleTimer=null;   // 坐地晕眩：5s后生气 / 生气后1分钟无操作回待机
  let _angrySeq=0;   // 坐地晕→生气→抱胸 序列 token：送礼/回待机时自增作废，避免链式回调误续播
  function scheduleSleepy(){
    if(_sleepyTimer) clearTimeout(_sleepyTimer);
    const delay = (60 + Math.random()*60) * 60000; // 60~120 分钟
    _sleepyTimer = setTimeout(function(){
      if(_angrySeq !== 0){ _sleepyTimer = setTimeout(arguments.callee, 60000); return; }  // 坐地晕序列进行中，不打断
      if(Date.now() < _busyUntil){ _sleepyTimer = setTimeout(arguments.callee, 60000); return; }
      goSleepy();
      scheduleSleepy();
    }, delay);
  }

  // 送礼：免费、无货币机制。玫瑰=惊喜→比心→接过玫瑰；蛋糕=惊喜→比心
  const GIFTS = [
    { emoji:'🌹', name:'玫瑰', type:'rose',  img: ROSE_IMG },
    { emoji:'🍰', name:'蛋糕', type:'cake', img: CAKE_IMG }
  ];
  function giveGift(btn, g){
    if(_transitioning) return;                    // 起身/坐下衔接中，不响应送礼，避免叠加
    if(_busyUntil > Date.now() && !(_sitMode || _name==='sitSleepy')) return;   // 反应中避免叠加；但睡着时送礼可强制唤醒
    _angrySeq = 0;                               // 坐地晕→生气序列作废：送礼插断后走礼物流程，1分钟计时不再触发
    const br = btn.getBoundingClientRect();
    const pr = petEl.getBoundingClientRect();
    const f = document.createElement('div');
    f.className = 'gift-float';
    if(g.img){ const im=document.createElement('img'); im.src=g.img; f.appendChild(im); }
    else { f.textContent = g.emoji; }
    f.style.left = (br.left + br.width/2) + 'px';
    f.style.top  = (br.top) + 'px';
    document.body.appendChild(f);
    requestAnimationFrame(function(){
      f.style.left = (pr.left + pr.width/2) + 'px';
      f.style.top  = (pr.top + pr.height*0.35) + 'px';
      f.style.opacity = '0.1';
      f.style.transform = 'translate(-50%,-50%) scale(0.4)';
    });
    setTimeout(function(){ if(f.parentNode) f.remove(); }, 900);
    const isRose = (g.type==='rose');
    _busyUntil = Date.now() + (isRose ? 6200 : 6000);   // 整个反应期间，自动反应让路
    if(_sitMode || _name==='sitSleepy'){
      _busyUntil = Date.now() + 8000;   // 唤醒衔接 + 送礼反应全程，自动反应让路
      wakeForGift(isRose);
    } else {
      _busyUntil = Date.now() + (isRose ? 6200 : 6000);   // 整个反应期间，自动反应让路
      giftReaction(isRose);
    }
  }

  // 模式切换 UI
  function setMode(m){
    if(!MODES[m]) return;
    mode = m;
    lsSet('pet_mode', m);
    document.querySelectorAll('#side button[data-mode]').forEach(function(b){
      b.classList.toggle('on', b.getAttribute('data-mode')===m);
    });
    scheduleCute(); // 立即按新模式重置计时
  }

  // 绑定侧栏按钮
  document.querySelectorAll('#side button[data-mode]').forEach(function(b){
    b.addEventListener('click', function(){ setMode(b.getAttribute('data-mode')); });
  });
  document.querySelectorAll('#side button[data-gift]').forEach(function(b){
    b.addEventListener('click', function(){
      giveGift(b, GIFTS[parseInt(b.getAttribute('data-gift'),10)] || GIFTS[0]);
    });
  });

  // 启动：模式生效 + 犯困计时 + 首次进入打招呼一次
  setMode(mode);
  scheduleSleepy();
  setTimeout(function(){ if(Date.now() >= _busyUntil) playOnce('wave'); }, 1200);  // 放置到桌面、开始使用时打招呼一次

})();
</script>
<!-- ===== 统一桌宠 UI：右键菜单 / 设置 / 聊天（网页版 + 桌面版共用） ===== -->
<div class="pui-menu pui-ui" id="puiMenu">
  <div class="pui-title">🐋 鲸鱼娘</div>
  <div class="pui-sep"></div>
  <div class="pui-item" data-toggle="mode"><span>🎭 模式</span><span class="pui-hint" id="puiModeHint">普通 ›</span></div>
  <div class="pui-sub" id="puiModeSub">
    <div class="pui-item pui-opt" data-mode="lively"><span>活泼 · 撒娇更勤</span><span class="pui-radio">○</span></div>
    <div class="pui-item pui-opt" data-mode="normal"><span>普通 · 约一分钟</span><span class="pui-radio">○</span></div>
    <div class="pui-item pui-opt" data-mode="quiet"><span>安静 · 很少打扰</span><span class="pui-radio">○</span></div>
  </div>
  <div class="pui-item" data-toggle="gift"><span>🎁 送礼</span><span class="pui-hint">展开 ›</span></div>
  <div class="pui-sub" id="puiGiftSub">
    <div class="pui-item" data-gift="0">🌹 玫瑰</div>
    <div class="pui-item" data-gift="1">🍰 蛋糕</div>
  </div>
  <div class="pui-sep"></div>
  <div class="pui-item" data-cmd="chat">💬 和它说话</div>
  <div class="pui-item" data-cmd="settings">⚙ 桌宠设置</div>
  <div class="pui-sep" data-desk="1"></div>
  <div class="pui-item" data-desk="1" data-cmd="hide">🙈 隐藏桌宠 <span class="pui-hint">托盘可恢复</span></div>
  <div class="pui-item" data-desk="1" data-cmd="quit">✖ 退出</div>
</div>

<div class="pui-settings pui-ui" id="puiSettings">
  <div class="pui-hd"><span>⚙ 桌宠设置</span><button class="pui-x" id="puiClose" title="关闭">×</button></div>
  <div class="pui-bd">
    <h4>AI 接口 · 自填 Key，默认不联网、不产生费用</h4>
    <div class="pui-row">
      <label><input type="checkbox" id="puiAiOn"> 启用 AI 对话（关闭时用内置本地回复）</label>
    </div>
    <div class="pui-row">
      <label for="puiProvider">服务商预设（均用 OpenAI 兼容 /chat/completions）</label>
      <select id="puiProvider">
        <option value="custom">自定义 / OpenAI 兼容</option>
        <option value="openai">OpenAI</option>
        <option value="deepseek">DeepSeek 深度求索</option>
        <option value="moonshot">Moonshot 月之暗面</option>
        <option value="zhipu">智谱 GLM</option>
        <option value="dashscope">阿里云百炼（通义）</option>
        <option value="siliconflow">硅基流动 SiliconFlow</option>
      </select>
    </div>
    <div class="pui-row"><label for="puiBase">Base URL</label><input type="text" id="puiBase" placeholder="https://api.openai.com/v1" autocomplete="off" spellcheck="false"></div>
    <div class="pui-row"><label for="puiKey">API Key</label><input type="password" id="puiKey" placeholder="sk-...（只保存在本机）" autocomplete="new-password"></div>
    <div class="pui-row"><label for="puiModel">模型名</label><input type="text" id="puiModel" placeholder="gpt-4o-mini" autocomplete="off" spellcheck="false"></div>
    <div class="pui-row"><label for="puiSys">人设 / System Prompt</label><textarea id="puiSys" placeholder="你是鲸鱼娘，一只温柔、爱撒娇、偶尔犯困的桌面宠物。回答简短自然，像聊天一样。"></textarea></div>
    <div class="pui-row"><label for="puiTemp">发散度 <span id="puiTempVal">0.7</span></label><input type="range" id="puiTemp" min="0" max="1" step="0.1" value="0.7"></div>
    <div class="pui-row pui-inline">
      <button class="pui-btn" id="puiTest">测试连接</button>
      <span class="pui-msg" id="puiTestMsg"></span>
    </div>
    <p class="pui-note" id="puiNote">Key 只保存在你自己的浏览器 / 本机，服务端不保存也不代付。聚合站内会走同源代理、桌面版由主进程代发，均不受 CORS 限制；其它托管方式自动回退直连。</p>

    <h4>互动 · 摔落反应</h4>
    <div class="pui-row">
      <label for="puiThrow">灵敏度（坐下晕乎乎 / 生气 的触发门槛）</label>
      <select id="puiThrow">
        <option value="gentle">迟钝 · 只有甩得很狠才晕</option>
        <option value="normal">标准 · 快甩或举很高才晕</option>
        <option value="sensitive">灵敏 · 稍微快一点就晕</option>
      </select>
    </div>
    <p class="pui-note">轻拿轻放不会触发。以「速度」为主判据（含撞到屏幕边缘后仍高速落下），举得「过高」也会触发；拖动时可以打开 文件?throwdebug=1 查看实时数值。</p>

    <div class="pui-desktop-only">
      <h4>窗口与外观 · 桌面版</h4>
      <div class="pui-row"><label for="puiWinMode">形态</label><select id="puiWinMode"><option value="roam">桌面漫游（全屏透明）</option><option value="widget">小窗口挂件（右下角）</option></select></div>
      <div class="pui-row"><label for="puiDisplay">显示器</label><select id="puiDisplay"></select></div>
      <div class="pui-row"><label for="puiOpacity">不透明度</label><select id="puiOpacity"><option value="1">100%</option><option value="0.85">85%</option><option value="0.7">70%</option><option value="0.55">55%</option></select></div>
      <div class="pui-row"><label><input type="checkbox" id="puiAutoStart"> 开机自动启动</label></div>
    </div>
  </div>
  <div class="pui-ft"><button class="pui-btn" id="puiCancel">取消</button><button class="pui-btn primary" id="puiSave">保存</button></div>
</div>

<div class="pui-bubble pui-ui" id="puiBubble"></div>
<div class="pui-chat pui-ui" id="puiChat">
  <input type="text" id="puiInput" placeholder="和鲸鱼娘说点什么…（Enter 发送 / Esc 关闭）" autocomplete="off">
  <button class="pui-btn primary" id="puiSend">发送</button>
</div>
<script>
/* ==========================================================================
   鲸鱼娘桌宠 · 统一 UI 逻辑（网页版 / 桌面版共用）
   - 网页版：配置存 localStorage；聚合站内走同源 /api/pet/llm 代理（绕开 CORS），
             其它静态托管 / 本地文件自动回退到 fetch 直连
   - 桌面版：检测 window.__desktop，配置存主进程 settings.json，
             API 由主进程代发（绕开浏览器 CORS）；窗口/外观项一并可用
   ========================================================================== */
(() => {
  'use strict';
  const DESK = !!(window.__desktop && window.__desktop.getSettings);
  const $ = s => document.querySelector(s);
  const $$ = s => Array.prototype.slice.call(document.querySelectorAll(s));
  if (DESK) document.body.classList.add('pui-is-desktop');
  $$('[data-desk]').forEach(el => { if (!DESK) el.remove(); });

  const LS_KEY = 'pet_ui_settings';
  const DEFAULT_SYS = '你是「鲸鱼娘」，一只温柔、爱撒娇、偶尔犯困的桌面宠物。用简短自然的中文回复（一般 1~3 句），像聊天一样，不要长篇大论，不要用 Markdown。';
  const PRESETS = {
    custom:      { baseUrl: '', model: '' },
    openai:      { baseUrl: 'https://api.openai.com/v1', model: 'gpt-4o-mini' },
    deepseek:    { baseUrl: 'https://api.deepseek.com/v1', model: 'deepseek-chat' },
    moonshot:    { baseUrl: 'https://api.moonshot.cn/v1', model: 'moonshot-v1-8k' },
    zhipu:       { baseUrl: 'https://open.bigmodel.cn/api/paas/v4', model: 'glm-4-flash' },
    dashscope:   { baseUrl: 'https://dashscope.aliyuncs.com/compatible-mode/v1', model: 'qwen-plus' },
    siliconflow: { baseUrl: 'https://api.siliconflow.cn/v1', model: 'Qwen/Qwen2.5-7B-Instruct' }
  };
  const MODE_LABEL = { lively: '活泼', normal: '普通', quiet: '安静' };
  /* 摔落门槛：与成品 script1 的 window.__petThrowCfg 对应。
     数值由 _throw_calibrate.js 的物理模拟标定；改这里即可整体调灵敏度。
     网页版/桌面版都写 localStorage（桌面版 Electron 同样支持），
     script1 启动时会读同一份 pet_throw_cfg，重启后依然生效。 */
  const THROW_LEVELS = {
    gentle:    { speed: 1750, liftRatio: 1.00 },
    normal:    { speed: 1250, liftRatio: 0.72 },
    sensitive: { speed: 850,  liftRatio: 0.50 }
  };
  const THROW_LS = 'pet_throw_level';
  function readThrowLevel() {
    try { const v = localStorage.getItem(THROW_LS); if (THROW_LEVELS[v]) return v; } catch (e) {}
    return 'normal';
  }
  function applyThrowLevel(level) {
    const cfg = THROW_LEVELS[level] || THROW_LEVELS.normal;
    try {
      localStorage.setItem(THROW_LS, level);
      localStorage.setItem('pet_throw_cfg', JSON.stringify(cfg));
    } catch (e) {}
    if (window.__petThrowCfg) Object.assign(window.__petThrowCfg, cfg);
  }
  const DEFAULT_AI = {
    enabled: false, provider: 'custom', baseUrl: '', apiKey: '', model: '',
    systemPrompt: DEFAULT_SYS, temperature: 0.7
  };
  let S = {
    ai: Object.assign({}, DEFAULT_AI),
    petMode: 'normal',
    desktop: { mode: 'roam', displayId: null, opacity: 1, autoStart: false },
    displays: []
  };

  /* ---------- 配置读写 ---------- */
  async function load() {
    if (DESK) {
      try {
        const d = await window.__desktop.getSettings();
        if (d) {
          S.ai = Object.assign({}, DEFAULT_AI, d.ai || {});
          S.petMode = d.petMode || S.petMode;
          S.desktop = Object.assign({}, S.desktop, d.desktop || {});
          S.displays = d.displays || [];
        }
      } catch (e) { /* 主进程未就绪：用默认值 */ }
    } else {
      try {
        const d = JSON.parse(localStorage.getItem(LS_KEY) || '{}');
        S.ai = Object.assign({}, DEFAULT_AI, d.ai || {});
        S.petMode = localStorage.getItem('pet_mode') || d.petMode || S.petMode;
      } catch (e) { /* ignore */ }
    }
  }
  async function persist() {
    if (DESK) { try { await window.__desktop.saveSettings(S); } catch (e) {} }
    else { try { localStorage.setItem(LS_KEY, JSON.stringify({ ai: S.ai, petMode: S.petMode })); } catch (e) {} }
  }

  /* ---------- LLM 调用（OpenAI 兼容 /chat/completions） ---------- */
  function endpoint(base) {
    const b = (base || '').trim().replace(/\/+$/, '');
    return /\/chat\/completions$/.test(b) ? b : b + '/chat/completions';
  }
  function bodyOf(ai, messages) {
    return {
      model: ai.model || 'gpt-4o-mini',
      messages: [{ role: 'system', content: ai.systemPrompt || DEFAULT_SYS }].concat(messages),
      temperature: Number(ai.temperature) || 0.7,
      max_tokens: 320,
      stream: false
    };
  }
  /* 网站版桌宠是把 13 个分片拼成 blob: 页面后再导航过去的，此时 location.origin
     不可靠；从 blob:https://host/uuid 里取出站点源，才能请求同源的 /api/pet/llm。 */
  function siteOrigin() {
    try {
      if (location.protocol === 'blob:') {
        const m = /^blob:(https?:\/\/[^/]+)/i.exec(location.href);
        return m ? m[1] : '';
      }
      return /^https?:$/.test(location.protocol) ? location.origin : '';
    } catch (e) { return ''; }
  }
  function fullMessages(ai, messages) {
    return [{ role: 'system', content: ai.systemPrompt || DEFAULT_SYS }].concat(messages);
  }
  async function chat(messages, ai) {
    if (DESK) {
      try { return await window.__desktop.aiChat({ messages: messages, ai: ai }); }
      catch (e) { return { ok: false, text: '调用失败：' + e.message }; }
    }
    const origin = siteOrigin();
    /* 聚合站自带 /api/pet/llm 代理：Key 仍是用户自己填的，服务端只转发不代付，
       同时绕开浏览器直连的 CORS 限制。别的静态托管没有该接口(404)时自动回退直连。 */
    if (origin) {
      try {
        const rp = await fetch(origin + '/api/pet/llm', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            key: ai.apiKey || '', baseUrl: ai.baseUrl, model: ai.model,
            temperature: Number(ai.temperature) || 0.7, max_tokens: 320,
            messages: fullMessages(ai, messages)
          })
        });
        if (rp.ok) {
          const j = await rp.json();
          return { ok: true, text: ((j && j.reply) || '').trim() || '（空回复）' };
        }
        if (rp.status !== 404 && rp.status !== 405) {
          const t = (await rp.text()).slice(0, 140);
          return { ok: false, text: '接口返回 ' + rp.status + '：' + t };
        }
      } catch (e) { /* 代理不可用，回退直连 */ }
    }
    try {
      const r = await fetch(endpoint(ai.baseUrl), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (ai.apiKey || '') },
        body: JSON.stringify(bodyOf(ai, messages))
      });
      if (!r.ok) {
        const t = (await r.text()).slice(0, 140);
        return { ok: false, text: '接口返回 ' + r.status + '：' + t };
      }
      const j = await r.json();
      const c = j && j.choices && j.choices[0] && j.choices[0].message && j.choices[0].message.content;
      return { ok: true, text: (c || '').trim() || '（空回复）' };
    } catch (e) {
      return { ok: false, text: '连接失败：' + e.message + '（网页直连可能被 CORS 拦截，桌面版或在聚合站内可绕开）' };
    }
  }

  /* ---------- 未接 API 时的本地兜底（完全离线、零费用） ---------- */
  const LOCAL = [
    '嗯嗯，我在听～ 不过还没给我接 API，先用内置小脑袋回你一句吧。',
    '（歪头）想真正聊天的话，右键 →「桌宠设置」里填上你自己的 Key 就行啦。',
    '收到收到！等我连上大脑再好好回你～',
    '嘿嘿，你现在看到的是离线模式，我不会偷偷联网也不会花你钱的。'
  ];
  function localReply(text) {
    const t = (text || '').toLowerCase();
    let s;
    if (/你好|您好|hi|hello|在吗|早|嗨|哈喽/.test(t)) s = '嗨嗨～我在呀！今天也陪着我好不好？';
    else if (/摸|抱|亲|喜欢|爱|乖|可爱/.test(t)) s = '嘿嘿…再摸摸头嘛，好舒服～ ♥';
    else if (/困|睡|晚安|累|休息/.test(t)) s = '唔…有点困了哈…（打个小哈欠）';
    else if (/吃|饿|蛋糕|玫瑰|礼物/.test(t)) s = '哇！给我的吗？我最喜欢收礼物啦～';
    else if (/生气|讨厌|笨|坏/.test(t)) s = '呜…别凶我嘛，我乖一点还不行吗…';
    else if (/名字|是谁|叫什么/.test(t)) s = '我是鲸鱼娘呀，住在你桌面上的那只～';
    else s = LOCAL[Math.floor(Math.random() * LOCAL.length)];
    return { ok: true, text: s, local: true };
  }

  /* ---------- 聊天气泡 / 输入条 ---------- */
  const bubble = $('#puiBubble'), chatBar = $('#puiChat'), input = $('#puiInput');
  let bubbleTimer = null;
  function place(el) {
    const p = document.getElementById('pet');
    if (!p) return;
    const r = p.getBoundingClientRect();
    const w = el.offsetWidth || 280, h = el.offsetHeight || 46;
    let x = r.left + r.width / 2 - w / 2;
    let y = r.top - h - 14;
    x = Math.max(8, Math.min(window.innerWidth - w - 8, x));
    if (y < 8) y = Math.min(window.innerHeight - h - 8, r.bottom + 12);
    el.style.left = Math.round(x) + 'px';
    el.style.top = Math.round(y) + 'px';
  }
  function showBubble(text, ms) {
    if (!bubble) return;
    bubble.textContent = text;
    bubble.classList.add('on');
    place(bubble);
    clearTimeout(bubbleTimer);
    bubbleTimer = setTimeout(() => bubble.classList.remove('on'), ms || 5200);
  }
  function openChat() {
    closeMenu();
    if (!chatBar) return;
    chatBar.classList.add('on');
    place(chatBar);
    if (DESK) window.__desktop.setFocus(true);
    setTimeout(() => { if (input) input.focus(); }, 30);
  }
  function closeChat() {
    if (chatBar) chatBar.classList.remove('on');
    if (DESK) window.__desktop.setFocus(false);
  }
  /* 回复里带情绪时做个小动作；坐下困（Zzz 可见）时不打断坐姿 */
  function maybeAct(text) {
    const zzz = document.getElementById('zzz');
    if (zzz && parseFloat(getComputedStyle(zzz).opacity || '0') > 0.15) return;
    let a = 'wave';
    if (/喜欢|抱|亲|开心|嘿|♥|爱/.test(text)) a = 'cute';
    else if (/困|睡|晚安|累/.test(text)) a = 'sleepy';
    else if (/生气|讨厌|哼/.test(text)) a = 'angry';
    const btn = document.querySelector('#panel button[data-act="' + a + '"]');
    if (btn) btn.click();
  }
  let sending = false;
  async function send() {
    if (!input || sending) return;
    const text = input.value.trim();
    if (!text) return;
    input.value = '';
    sending = true;
    showBubble('……', 30000);
    const ai = S.ai;
    let r;
    if (ai.enabled && ai.apiKey && ai.baseUrl && ai.model) r = await chat([{ role: 'user', content: text }], ai);
    else r = localReply(text);
    showBubble(r.text, r.ok ? 7000 : 9000);
    if (r.ok) maybeAct(r.text);
    sending = false;
  }
  if (input) input.addEventListener('keydown', e => {
    if (e.key === 'Enter') { e.preventDefault(); send(); }
    else if (e.key === 'Escape') { e.preventDefault(); input.blur(); closeChat(); }
  });
  const sendBtn = $('#puiSend');
  if (sendBtn) sendBtn.addEventListener('click', send);

  /* ---------- 右键菜单 ---------- */
  const menu = $('#puiMenu');
  function closeMenu() { if (menu) menu.classList.remove('on'); }
  function openMenu(x, y) {
    if (!menu) return;
    menu.classList.add('on');
    const w = menu.offsetWidth, h = menu.offsetHeight;
    menu.style.left = Math.max(8, Math.min(x, window.innerWidth - w - 8)) + 'px';
    menu.style.top = Math.max(8, Math.min(y, window.innerHeight - h - 8)) + 'px';
  }
  const pet = document.getElementById('pet');
  if (pet) pet.addEventListener('contextmenu', e => {
    e.preventDefault(); e.stopPropagation();
    openMenu(e.clientX, e.clientY);
  });
  if (menu) {
    menu.addEventListener('contextmenu', e => e.preventDefault());
    $$('#puiMenu [data-toggle]').forEach(el => el.addEventListener('click', () => {
      const id = 'pui' + (el.dataset.toggle === 'mode' ? 'ModeSub' : 'GiftSub');
      const sub = document.getElementById(id);
      if (sub) sub.classList.toggle('on');
    }));
    /* 模式：复用原版隐藏按钮，setMode 会写 localStorage 并重排自动撒娇计时 */
    $$('#puiModeSub [data-mode]').forEach(el => el.addEventListener('click', () => {
      applyMode(el.dataset.mode);
      closeMenu();
    }));
    /* 送礼：原版 giveGift 用按钮 rect 当飞行起点，先临时把 #side 摆到桌宠旁 */
    $$('#puiGiftSub [data-gift]').forEach(el => el.addEventListener('click', () => {
      gift(parseInt(el.dataset.gift, 10));
      closeMenu();
    }));
    $$('#puiMenu [data-cmd]').forEach(el => el.addEventListener('click', () => {
      const c = el.dataset.cmd;
      closeMenu();
      if (c === 'chat') openChat();
      else if (c === 'settings') openSettings();
      else if (c === 'hide' && DESK) window.__desktop.hidePet();
      else if (c === 'quit' && DESK) window.__desktop.quit();
    }));
  }
  function applyMode(m) {
    if (!MODE_LABEL[m]) return;
    S.petMode = m;
    const btn = document.querySelector('#side button[data-mode="' + m + '"]');
    if (btn) btn.click();
    $$('#puiModeSub [data-mode]').forEach(o => {
      const on = o.dataset.mode === m;
      o.classList.toggle('sel', on);
      const r = o.querySelector('.pui-radio');
      if (r) r.textContent = on ? '●' : '○';
    });
    const hint = $('#puiModeHint');
    if (hint) hint.textContent = MODE_LABEL[m] + ' ›';
    if (DESK) { try { window.__desktop.savePetMode(m); } catch (e) {} }
    else { try { localStorage.setItem(LS_KEY, JSON.stringify({ ai: S.ai, petMode: m })); } catch (e) {} }
  }
  function gift(i) {
    const side = document.getElementById('side');
    const btn = document.querySelector('#side button[data-gift="' + i + '"]');
    if (!side || !btn) return;
    const r = pet.getBoundingClientRect();
    const old = side.getAttribute('style') || '';
    side.style.cssText = 'display:block!important;position:fixed!important;' +
      'left:' + Math.round(r.left + r.width / 2) + 'px!important;' +
      'top:' + Math.round(r.top + r.height * 0.4) + 'px!important;' +
      'width:1px!important;height:1px!important;overflow:hidden!important;' +
      'opacity:0!important;pointer-events:none!important;';
    try { btn.click(); } finally { side.setAttribute('style', old); }
  }
  document.addEventListener('pointerdown', e => {
    if (menu && menu.classList.contains('on') && !(e.target.closest && e.target.closest('#puiMenu'))) closeMenu();
  }, true);
  document.addEventListener('contextmenu', e => {
    if (e.target.closest && e.target.closest('.pui-ui')) e.preventDefault();
  });
  window.addEventListener('resize', () => { if (bubble) place(bubble); if (chatBar) place(chatBar); closeMenu(); });

  /* ---------- 设置面板 ---------- */
  const settings = $('#puiSettings');
  function fill() {
    if (!$('#puiAiOn')) return;
    $('#puiAiOn').checked = !!S.ai.enabled;
    $('#puiProvider').value = S.ai.provider || 'custom';
    $('#puiBase').value = S.ai.baseUrl || '';
    $('#puiKey').value = S.ai.apiKey || '';
    $('#puiModel').value = S.ai.model || '';
    $('#puiSys').value = S.ai.systemPrompt || DEFAULT_SYS;
    $('#puiTemp').value = String(S.ai.temperature != null ? S.ai.temperature : 0.7);
    $('#puiTempVal').textContent = $('#puiTemp').value;
    $('#puiTestMsg').textContent = '';
    $('#puiTestMsg').className = 'pui-msg';
    $('#puiNote').textContent = DESK
      ? 'Key 只保存在本机配置文件；桌面版由主进程代发请求，可绕开浏览器 CORS。不填 Key 时完全离线、零费用。'
      : 'Key 只保存在本机浏览器；网页版直连可能受 CORS 限制，桌面版由主进程代发可绕开。不填 Key 时完全离线、零费用。';
    const dm = $('#puiDisplay');
    if (dm) {
      dm.innerHTML = '';
      const o0 = document.createElement('option');
      o0.value = ''; o0.textContent = '自动（主显示器）'; dm.appendChild(o0);
      (S.displays || []).forEach((d, i) => {
        const o = document.createElement('option');
        o.value = String(d.id); o.textContent = '显示器 ' + (i + 1) + '　' + d.width + '×' + d.height;
        dm.appendChild(o);
      });
      dm.value = S.desktop.displayId == null ? '' : String(S.desktop.displayId);
    }
    if ($('#puiWinMode')) $('#puiWinMode').value = S.desktop.mode || 'roam';
    if ($('#puiOpacity')) $('#puiOpacity').value = String(S.desktop.opacity || 1);
    if ($('#puiAutoStart')) $('#puiAutoStart').checked = !!S.desktop.autoStart;
    if ($('#puiThrow')) $('#puiThrow').value = readThrowLevel();
  }
  function collect() {
    S.ai = {
      enabled: $('#puiAiOn').checked,
      provider: $('#puiProvider').value,
      baseUrl: $('#puiBase').value.trim(),
      apiKey: $('#puiKey').value.trim(),
      model: $('#puiModel').value.trim(),
      systemPrompt: $('#puiSys').value.trim() || DEFAULT_SYS,
      temperature: parseFloat($('#puiTemp').value)
    };
    if ($('#puiWinMode')) S.desktop = {
      mode: $('#puiWinMode').value,
      displayId: $('#puiDisplay').value === '' ? null : Number($('#puiDisplay').value),
      opacity: parseFloat($('#puiOpacity').value),
      autoStart: $('#puiAutoStart').checked
    };
    if ($('#puiThrow')) applyThrowLevel($('#puiThrow').value);
  }
  async function openSettings() {
    closeMenu();
    await load();          // 每次打开都取本机最新配置（含显示器列表）
    fill();
    if (settings) settings.classList.add('on');
    if (DESK) window.__desktop.setFocus(true);
  }
  function closeSettings() {
    if (settings) settings.classList.remove('on');
    if (DESK) window.__desktop.setFocus(false);
  }
  if ($('#puiClose')) $('#puiClose').addEventListener('click', closeSettings);
  if ($('#puiCancel')) $('#puiCancel').addEventListener('click', closeSettings);
  if ($('#puiSave')) $('#puiSave').addEventListener('click', async () => {
    collect();
    await persist();
    closeSettings();
    showBubble('设置已保存～', 2600);
  });
  if ($('#puiProvider')) $('#puiProvider').addEventListener('change', e => {
    const p = PRESETS[e.target.value];
    if (p && p.baseUrl) { $('#puiBase').value = p.baseUrl; $('#puiModel').value = p.model; }
  });
  if ($('#puiTemp')) $('#puiTemp').addEventListener('input', e => {
    $('#puiTempVal').textContent = e.target.value;
  });
  if ($('#puiTest')) $('#puiTest').addEventListener('click', async () => {
    collect();
    const msg = $('#puiTestMsg');
    const ai = S.ai;
    if (!ai.apiKey || !ai.baseUrl || !ai.model) {
      msg.textContent = '请先填 Base URL / API Key / 模型名'; msg.className = 'pui-msg err'; return;
    }
    msg.textContent = '连接中…'; msg.className = 'pui-msg';
    const r = await chat([{ role: 'user', content: '请只回复一个字：在' }], ai);
    msg.textContent = r.ok ? '✓ 连接成功：' + r.text.slice(0, 30) : '✗ ' + r.text.slice(0, 90);
    msg.className = 'pui-msg ' + (r.ok ? 'ok' : 'err');
  });

  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (settings && settings.classList.contains('on')) closeSettings();
    else if (chatBar && chatBar.classList.contains('on')) closeChat();
    else closeMenu();
  });
  if (DESK) {
    /* 透明窗口默认 focusable:false，输入前临时打开焦点，收起后还原 */
    document.addEventListener('focusin', e => {
      if (e.target.closest && e.target.closest('.pui-ui')) window.__desktop.setFocus(true);
    });
    document.addEventListener('focusout', () => {
      setTimeout(() => {
        const a = document.activeElement;
        if (!a || !a.closest || !a.closest('.pui-ui')) {
          if (!settings || !settings.classList.contains('on')) window.__desktop.setFocus(false);
        }
      }, 0);
    });
  }

  /* ---------- 启动 ---------- */
  load().then(() => { fill(); applyThrowLevel(readThrowLevel()); applyMode(S.petMode || 'normal'); });
  window.__petUI = {
    showBubble, openSettings, openChat,
    setMode: applyMode, gift,
    getSettings: () => S
  };
})();
</script>
</body>
</html>
