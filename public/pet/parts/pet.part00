<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>鲸鱼娘 · Live2D 桌宠（真·眼睛追踪）</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html,body { height:100%; }
  body {
    font-family: "PingFang SC","Microsoft YaHei",system-ui,sans-serif;
    background: radial-gradient(120% 120% at 50% 0%, #eaf3ff 0%, #dce9ff 45%, #c9ddff 100%);
    overflow:hidden; color:#243b66;
  }
  #stage { position:fixed; inset:0; }
  .hint { position:fixed; left:50%; bottom:22px; transform:translateX(-50%);
    font-size:13px; color:rgba(40,60,100,.6); letter-spacing:.5px; user-select:none; }

  #pet {
    position:absolute; left:50%; top:46%;
    width:220px; height:330px;
    transform:translate(-50%,-50%);
    cursor:grab; will-change:transform,left,top; touch-action:none;
    user-select:none; -webkit-user-select:none; -moz-user-select:none;
  }
  #pet.drag { cursor:grabbing; }
  /* 拖拽时禁止浏览器原生选区高亮（默认 ::selection 蓝框）与图片原生拖拽残影 */
  #pet * { user-select:none; -webkit-user-select:none; -moz-user-select:none; -webkit-user-drag:none; user-drag:none; }
  #pet::selection, #pet *::selection { background:transparent; }

  /* 地面参考线（开发期可视化；后期接入任务栏边界后可隐藏/移除） */
  #ground { position:absolute; left:0; right:0; top:0; height:0;
    border-top:1px dashed rgba(60,90,150,.38); pointer-events:none; z-index:1; display:none; }

  #rig { position:absolute; inset:0; transform-origin:50% 100%; will-change:transform; }
  /* 拖拽被拎起：上提 + 以"脖颈"为支点轻轻晃（像被提着后颈摇晃） */
  #rig.dragging { transform-origin:50% 10%; animation: carrySway 1.15s ease-in-out infinite; }
  @keyframes carrySway {
    0%   { transform: translateY(-16px) rotate(-3.5deg); }
    25%  { transform: translateY(-19px) rotate(0deg); }
    50%  { transform: translateY(-16px) rotate(3.5deg); }
    75%  { transform: translateY(-19px) rotate(0deg); }
    100% { transform: translateY(-16px) rotate(-3.5deg); }
  }

  /* 角色整体投影：用 drop-shadow 取代原来的"深色复制壳"——只向下投一道柔影做厚度/接地感，
     绝不在背后垫一整层暗色同形，避免看上去像"第二只"。 */
  #fig { position:absolute; inset:0; filter: drop-shadow(0 12px 14px rgba(16,40,82,.30)); will-change:transform; }

  .band { position:absolute; inset:0; transform-origin:50% 100%; will-change:transform; }
  .band img { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; display:block; }
  /* 头部以"脖子"为轴转向光标，避免转头时和身子分家 */
  #head { transform-origin:50% 50%; }

  /* 眼神层：黑眼珠+高光，作为头的子层，只在虹膜内平移 */
  #gaze { position:absolute; inset:0; will-change:transform; }
  #gaze img { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; display:block; }

  /* 眨眼层：静止时完全隐藏(opacity:0)，并预先上移到眼睛上方；
     眨眼时先快速淡入(在眼睛上方)，再随 translateY 向下扫合——上眼睑连带睫毛一起从上方落下 */
  #lid { opacity:0; transform: translateY(-15px); will-change:transform,opacity; }

  #shade, #light {
    position:absolute; inset:0; pointer-events:none;
    -webkit-mask:var(--mask) center/contain no-repeat; mask:var(--mask) center/contain no-repeat;
    filter: blur(5px);   /* 边界羽化，避免亮暗边缘生硬潦草 */
  }
  /* 动态光：极弱、宽、柔，仅作为鼠标方向的轻微明暗反馈，不再像圆灯扫脸 */
  #shade { mix-blend-mode:multiply;
    background:radial-gradient(95% 95% at var(--sx,62%) var(--sy,72%), rgba(6,14,36,.16), rgba(6,14,36,0) 66%); }
  #light { mix-blend-mode:screen;
    background:radial-gradient(82% 82% at var(--lx,40%) var(--ly,30%), rgba(255,255,255,.22), rgba(255,255,255,0) 64%); }

  /* 固定弧形体积光：顶部弧形高光 + 底部弧形阴影(环境光遮蔽)，贴合角色轮廓，
     让明暗来自身体形状本身、呈弧形柔和过渡，而非跟随鼠标的圆斑 */
  #form {
    position:absolute; inset:0; pointer-events:none;
    -webkit-mask:var(--mask) center/contain no-repeat; mask:var(--mask) center/contain no-repeat;
    mix-blend-mode:soft-light;
    background:
      radial-gradient(125% 95% at 40% 9%, rgba(255,255,255,.55), rgba(255,255,255,0) 50%),
      radial-gradient(135% 120% at 60% 97%, rgba(10,20,46,.55), rgba(10,20,46,0) 52%);
  }
  /* 黑块修复：动作/反应/坐姿/起身过渡期间（body.acting）彻底关闭两个变暗混合层
     #shade(multiply) / #form(soft-light)，仅保留 #light 高光。根因：两层用待机轮廓遮罩，
     非待机画面（动作姿势与待机不符）时深色溢出到空白区 → 黑块。停手时 class 移除、待机光影照常。 */
  body.acting #shade, body.acting #form { display:none !important; }

  #shadow {
    position:absolute; left:50%; bottom:-6px;
    width:62%; height:20px; transform:translateX(-50%);
    background:radial-gradient(ellipse at center, rgba(20,45,90,.42), rgba(20,45,90,0) 72%);
    filter:blur(7px); pointer-events:none; will-change:transform,opacity;
  }

  /* 动作层放在 #rig 内部、#fig 之后 —— 这样 #form/#shade/#light 三层光影会同样作用在
     动作帧上，动作与待机的明暗/色调才是同一套光照，不会出现"换了个颜色的角色"。 */
  #act { position:absolute; inset:0; display:none; pointer-events:none; }
  /* 动作帧（sitDizzy / angryPout）的肤色已逐帧对齐「待机皮肤 (247,231,221)」烘焙进 PNG：
     做法是取回原始 AI 立绘、只对皮肤像素做逐通道增益，保留腮红/体积明暗与白色布料。
     所以这里无需再做 brightness/sepia 调色，只保留与 #fig 一致的投影。 */
  #act img { width:100%; height:100%; object-fit:contain;
    filter:drop-shadow(0 12px 14px rgba(16,40,82,.30)); }
  #panel { position:fixed; left:50%; bottom:48px; transform:translateX(-50%);
    display:flex; gap:8px; z-index:30; }
  #panel button { font:inherit; font-size:13px; padding:7px 12px; border:1px solid rgba(40,70,130,.25);
    border-radius:20px; background:rgba(255,255,255,.86); color:#2a4470; cursor:pointer;
    backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px);
    box-shadow:0 3px 10px rgba(20,45,90,.12); transition:.15s; user-select:none; }
  #panel button:hover { background:#fff; transform:translateY(-1px); }
  #panel button.on { background:#ffd6e7; border-color:#ff9ec4; color:#b83a6b; }

  /* 侧边控制：使用模式 + 送礼 */
  #side { position:fixed; right:14px; top:14px; z-index:30; display:flex; flex-direction:column; gap:8px; align-items:flex-end; }
  #side .grp { display:flex; gap:6px; align-items:center;
    background:rgba(255,255,255,.82); backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px);
    padding:6px 8px; border-radius:16px; box-shadow:0 3px 10px rgba(20,45,90,.12); border:1px solid rgba(40,70,130,.18); }
  #side .lbl { font-size:12px; color:#5a76a8; user-select:none; }
  #side button { font:inherit; font-size:12px; padding:5px 10px; border:1px solid rgba(40,70,130,.25);
    border-radius:14px; background:#fff; color:#2a4470; cursor:pointer; transition:.15s; user-select:none; }
  #side button:hover { background:#eef4ff; transform:translateY(-1px); }
  #side button.on { background:#ffd6e7; border-color:#ff9ec4; color:#b83a6b; }

  /* 礼物飞向桌宠的动画 */
  .gift-float { position:fixed; z-index:50; font-size:30px; pointer-events:none;
    transform:translate(-50%,-50%) scale(1); opacity:1;
    transition:left .7s ease-in, top .7s ease-in, opacity .7s ease-in, transform .7s ease-in;
    filter:drop-shadow(0 3px 6px rgba(20,45,90,.3)); }
  .gift-float img { width:48px; height:48px; display:block; object-fit:contain; }

  
  /* 坐下犯困：精灵以脚为支点呼吸/轻晃 */
  #actImg{ transform-origin:50% 100%; }
  #actImg, #actImg2, #actImg3{ position:absolute; inset:0; transform-origin:50% 100%; }
  #actImg2{ opacity:0; }
  #actImg3{ opacity:0; }
  .sit-anim{ transition: transform .7s cubic-bezier(.4,0,.2,1), opacity .35s ease; }
  /* 起身衔接：仅在「坐下困 → 待机」时挂上，避免影响普通动作切换 */
  .act-fade{ transition: opacity .45s ease; }
  .fig-fade{ transition: opacity .55s ease; }
  #zzz{
    position:absolute; top:4%; right:32%;
    font:700 22px/1 "Segoe UI",system-ui,sans-serif;
    color:#9ad0ff; text-shadow:0 1px 2px #fff,0 0 6px #cdeeff;
    transform:rotate(-8deg); opacity:0; pointer-events:none; user-select:none;
  }
  #zzz.on{ animation:zzzfloat 3.4s ease-in-out infinite; }
  @keyframes zzzfloat{
    0%   { opacity:0; transform:translate(0,0) rotate(-8deg) scale(.7); }
    25%  { opacity:.95; }
    100% { opacity:0; transform:translate(16px,-52px) rotate(8deg) scale(1.2); }
  }
</style>
</head>
<body>
<div id="stage">
  <div id="ground"></div>
  <div id="pet">
    <div id="shadow"></div>
    <div id="rig">
      <div id="fig">
        <div class="band" id="skirt"><img src="data:image/png;base64," alt=""></div>
        <div class="band" id="body"><img src="data:image/png;base64," alt=""></div>
        <div class="band" id="head">
          <img src="data:image/png;base64," alt="">
          <div id="gaze"><img src="data:image/png;base64," alt=""></div>
          <img id="lid" src="data:image/png;base64," alt="">
        </div>
      </div>
      <div id="act"><img id="actImg" src="" alt=""><img id="actImg2" src="" alt=""><img id="actImg3" src="" alt=""></div>
      <div id="zzz">Zzz</div>
      <div id="form"></div>
      <div id="shade"></div>
      <div id="light"></div>
    </div>
  </div>
</div>
<div id="panel">
    <button data-act="wave">👋 打招呼</button>
    <button data-act="heart">💗 比心</button>
    <button data-act="cute">🥰 撒娇</button>
    <button data-act="angry">😡 生气</button>
    <button data-act="sleepy">😪 犯困</button>
    <button data-act="sitSleepy">🪑 坐下困</button>
    <button data-act="idle">💤 待机</button>
  </div>
<div id="side">
  <div class="grp"><span class="lbl">模式</span>
    <button data-mode="lively">活泼</button>
    <button data-mode="normal">普通</button>
    <button data-mode="quiet">安静</button>
  </div>
  <div class="grp"><span class="lbl">送礼</span>
    <button data-gift="0">🌹 玫瑰</button>
    <button data-gift="1">🍰 蛋糕</button>
  </div>
</div>
<div class="hint">🖱 移动鼠标＝头部转向光标 + 眼珠在虹膜里跟着看 · 拖拽＝移动 · 收礼会💗比心 · 久用会😪犯困</div>

<script>
const MASK = "data:image/png;base64,";
document.documentElement.style.setProperty('--mask', 'url(' + MASK + ')');

const pet   = document.getElementById('pet');
const rig   = document.getElementById('rig');
const skirt = document.getElementById('skirt');
const body  = document.getElementById('body');
const head  = document.getElementById('head');
const gaze  = document.getElementById('gaze');
const lid   = document.getElementById('lid');
const light = document.getElementById('light');
const shade = document.getElementById('shade');
const shadow= document.getElementById('shadow');
  window.__eyesClosed=false;
  window.__setEyesClosed=function(b){ window.__eyesClosed=!!b; };

/* 各深度带的视差强度（前层动得多，后层动得少 → 真实纵深）。全部跟随，故不会重影/断层 */
const DEPTH = { skirt:0.30, body:0.62, head:1.00 };
const PX = 4;  // 头部最大水平视差(px)：收窄，让各层更贴成一体、减少分离感

/* 眼神层最大位移（CSS px）。头部显示220px宽、原图1024px，缩放约0.215，
   故 2.8px ≈ 13图像像素，黑眼珠在虹膜(rx≈38)内平移，不会甩出眼眶 */
const GMAX_X = 2.8, GMAX_Y = 1.9;

let mTX=0, mTY=0, mCX=0, mCY=0, gX=0, gY=0;
window.addEventListener('mousemove', e=>{
  const r = pet.getBoundingClientRect();
  const cx = r.left + r.width/2, cy = r.top + r.height/2;
  mTX = Math.max(-1, Math.min(1, (e.clientX-cx)/(window.innerWidth*0.5)));
  mTY = Math.max(-1, Math.min(1, (e.clientY-cy)/(window.innerHeight*0.5)));
  const lx = (e.clientX-r.left)/r.width*100;
  const ly = (e.clientY-r.top)/r.height*100;
  light.style.setProperty('--lx', lx+'%');
  light.style.setProperty('--ly', ly+'%');
  shade.style.setProperty('--sx',(100-lx)+'%');
  shade.style.setProperty('--sy',(100-ly)+'%');
});
window.addEventListener('mouseleave', ()=>{ mTX=0; mTY=0; });

/* ===== 地面 + 重力（物理系统）=====
   后期接入：把 GROUND_MARGIN 换成"桌面任务栏高度"，GROUND_Y 即任务栏上沿。
   现在先用固定预留值建立地面，并让桌宠无论如何都会掉到地面上。 */
const SHOW_GROUND = true;        // 开发期显示地面参考线；接任务栏后可改 false
const GROUND_MARGIN = 40;        // 距视口底部预留（占位：后期 = 任务栏高度）
const GRAVITY = 2600;            // 重力加速度 px/s^2
const RESTITUTION = 0.42;        // 落地回弹系数（0=不弹，1=完全弹）
const AIR_DRAG = 2.2;            // 空中水平阻力(1/s)
const FLOOR_DRAG = 7.0;          // 贴地水平摩擦(1/s)
const MAX_V = 2600;              // 速度上限 px/s（防止甩飞）
let GROUND_Y = 0;                // 宠物"脚底"落地的屏幕 Y
let petW = 220, petH = 330;      // 宠物尺寸（resize 时刷新）
let pvx = 0, pvy = 0;            // 宠物速度 px/s
let onGround = false;
const groundEl = document.getElementById('ground');
if(groundEl) groundEl.style.display = SHOW_GROUND ? 'block' : 'none';

function calcGround(){
  GROUND_Y = window.innerHeight - GROUND_MARGIN;
  if(groundEl) groundEl.style.top = GROUND_Y + 'px';
  const r = pet.getBoundingClientRect();
  if(r.width)  petW = r.width;
  if(r.height) petH = r.height;
}
function initPetPhysics(){
  pet.style.transform = 'none';   // 去掉 CSS 居中 transform，改用绝对 px 定位
  const w = pet.getBoundingClientRect().width  || 220;
  const h = pet.getBoundingClientRect().height || 330;
  pet.style.left = (window.innerWidth/2 - w/2) + 'px';          // 起点：水平居中
  pet.style.top  = (window.innerHeight*0.46 - h/2) + 'px';      // 约 46% 高度（之后重力会把它拽到地面）
}
/* 物理步进：非拖拽时由 frame() 每帧调用。横向惯性衰减、纵向重力下落、落地回弹、左右软墙。 */
function physics(dt){
  if(drag) return;                       // 指针按住拖拽中 → 位置由指针控制，不参与物理
  const restTop = GROUND_Y - petH;      // 脚底贴地时 #pet 的 top
  const fr = onGround ? FLOOR_DRAG : AIR_DRAG;
  pvx -= pvx * fr * dt;                 // 横向阻力衰减（惯性慢慢停）
  pvy += GRAVITY * dt;                  // 纵向重力
  let left = parseFloat(pet.style.left) || 0;
  let top  = parseFloat(pet.style.top)  || 0;
  left += pvx * dt; top += pvy * dt;    // 积分位移
  if(left < 0){ left = 0; pvx = -pvx*0.5; }                                          // 左软墙
  else if(left > window.innerWidth - petW){ left = window.innerWidth - petW; pvx = -pvx*0.5; } // 右软墙
  if(top >= restTop){                    // 地面碰撞
    top = restTop;
    if(_thrown){                         // 被抛出后落地 → 倒地晕眩（不切待机、不再回弹）
      _thrown = false; onGround = true; pvx *= 0.55; pvy = 0;
      if(window.__landDizzy) window.__landDizzy();
    } else if(pvy > 80){ pvy = -pvy * RESTITUTION; }    // 下落够快 → 回弹
    else { pvy = 0; onGround = true; pvx *= 0.55; }     // 落稳，贴地摩擦
  } else { onGround = false; }
  pet.style.left = left + 'px';
  pet.style.top  = top  + 'px';
}
calcGround(); initPetPhysics(); calcGround();
window.addEventListener('resize', calcGround);

/* 拖拽（松手交予物理系统：抛出惯性 + 重力回落） */
let drag=false, sx=0, sy=0, ox=0, oy=0, _dragging=false, dragShown=false, _thrown=false;
let vx=0, vy=0, _lastX=0, _lastY=0, _lastT=0;
pet.addEventListener('pointerdown', e=>{
  e.preventDefault();   // 阻止浏览器发起原生选区/图片拖拽（消除拖拽时的蓝色高亮框）
  pet.style.transition='';                        // 清掉可能的过渡，按下即贴手
  pvx = pvy = 0; onGround = false;               // 被拎起：清空速度，重力暂停
  drag=true; dragShown=false; sx=e.clientX; sy=e.clientY;
  const r=pet.getBoundingClientRect();
  ox=r.left; oy=r.top;
  vx=vy=0; _lastX=e.clientX; _lastY=e.clientY; _lastT=performance.now();
  pet.setPointerCapture(e.pointerId); pet.classList.add('drag');
});
pet.addEventListener('pointermove', e=>{
  if(!drag) return;
  pet.style.left = (ox + (e.clientX-sx)) + 'px';
  pet.style.top  = (oy + (e.clientY-sy)) + 'px';
  pet.style.transform = 'none';
  // 记录实时速度(px/ms)，用于松手时交给物理系统
  const now=performance.now(), dt=now-_lastT;
  if(dt>0){ vx=(e.clientX-_lastX)/dt; vy=(e.clientY-_lastY)/dt; }
  _lastX=e.clientX; _lastY=e.clientY; _lastT=now;
  // 超过阈值即视为真正开始拖拽 → 进入"被拎起"状态（>< 晕眼 + 提起摇晃）
  if(!dragShown && (Math.abs(e.clientX-sx)>4 || Math.abs(e.clientY-sy)>4)){
    window.__enterDrag(); dragShown=true;
  }
});
pet.addEventListener('pointerup', e=>{
  if(dragShown){
    // 把松手瞬间的指针速度(px/ms)换算成 px/s 交给物理系统 → 沿抛出方向飞出 + 重力拉回地面
    pvx = Math.max(-MAX_V, Math.min(MAX_V, vx*1000));
    pvy = Math.max(-MAX_V, Math.min(MAX_V, vy*1000));
    pet.style.transition='';
    _thrown = true;   // 进入"飞行中"：保持被拎起的晕眼姿势，直到落地才转倒地晕眩
  }
  drag=false; pet.classList.remove('drag');
});
// 注：被拎起的实际逻辑 enterDrag/exitDrag 定义在下方 IIFE 内（需调用 stopAction），
// 通过 window.__enterDrag / window.__exitDrag 暴露给这里的拖拽监听器。

/* 眨眼调度（眨眼时隐藏眼神层，露出闭眼）。放慢+缓动，确保肉眼可见 */
let nextBlink = 1.0 + Math.random()*2.0, blinkT = -1;

let last = performance.now();
function frame(now){
  const dt = Math.min((now-last)/1000, 0.05); last = now;
  physics(dt);                       // 地面重力：非拖拽时让桌宠下落并贴地（无论如何都会掉到地面）
  const t  = now/1000;
  const breath = Math.sin(t*1.5);
  const sway   = Math.sin(t*0.7);

  mCX += (mTX-mCX)*0.07; mCY += (mTY-mCY)*0.07;

  /* 各深度带：跟随光标的视差位移（前层多、后层少，且都小于羽化带宽→无缝） */
  const txS = mCX*PX*DEPTH.skirt, tyS = mCY*PX*0.30*DEPTH.skirt;
  const txB = mCX*PX*DEPTH.body,  tyB = mCY*PX*0.30*DEPTH.body;
  const txH = mCX*PX,            tyH = mCY*PX*0.30;
  skirt.style.transform = 'translate('+txS.toFixed(2)+'px,'+tyS.toFixed(2)+'px)';
  body.style.transform  = 'translate('+txB.toFixed(2)+'px,'+tyB.toFixed(2)+'px)';
  /* 头部：以脖子为轴轻微转向光标（转头幅度收窄，避免脖子接缝露缝） */
  const headRot = (mCX*1.3 + sway*0.9);
  head.style.transform  = 'translate('+txH.toFixed(2)+'px,'+tyH.toFixed(2)+'px) rotate('+headRot.toFixed(2)+'deg)';

  /* 眼神层：黑眼珠在虹膜内朝光标平移（比头略快一点点，像"先看再转头"） */
  gX += (mCX*GMAX_X - gX)*0.13;
  gY += (mTY*GMAX_Y - gY)*0.13;
  gaze.style.transform  = 'translate('+gX.toFixed(2)+'px,'+gY.toFixed(2)+'px)';

  /* 整体呼吸（脚底为支点轻微缩放） */
  const sxv = 1 - 0.012*breath, syv = 1 + 0.020*breath;
  const bob = Math.sin(t*1.5)*2;
  if(!_dragging) rig.style.transform = 'translateY('+bob.toFixed(2)+'px) scale('+sxv.toFixed(4)+','+syv.toFixed(4)+')';   // 拖拽被拎起时改由 CSS carrySway 动画接管 #rig 的 transform

  /* 眨眼 */
  if(blinkT<0){ nextBlink-=dt; if(nextBlink<=0) blinkT=0; }
  let blinkAmt=0;
  if(blinkT>=0){
    blinkT+=dt; const dur=0.26;
    const p = Math.min(1, blinkT/dur);
    // smoothstep：先缓闭、再缓开，肉眼清晰可见
    if(p<0.5){ const a=p/0.5; blinkAmt=a*a*(3-2*a); }
    else     { const a=(p-0.5)/0.5; blinkAmt=1-a*a*(3-2*a); }
    if(blinkT>=dur){ blinkT=-1; nextBlink=2.2+Math.random()*2.8; }
  }
  /* 眨眼：上眼睑从眼睛上方落下——前段(blinkAmt*3)快速淡入(此时仍在眼上方)，
     随后随 translateY 从 -15px→0 向下扫合盖住整眼，睫毛随眼睑一起下移。瞳孔同步淡出。 */
  if(window.__eyesClosed){
    lid.style.opacity='1'; lid.style.transform='translateY(0)'; gaze.style.opacity='0';
  } else {
    lid.style.opacity    = Math.min(1, blinkAmt*3).toFixed(3);
    lid.style.transform  = 'translateY(' + (-15*(1-blinkAmt)).toFixed(2) + 'px)';
    gaze.style.opacity   = (1-blinkAmt).toFixed(3);
  }

  /* 接触阴影随呼吸轻微变化 */
  const zk = 1 + 0.03*breath;
  shadow.style.transform = 'translateX(-50%) scale('+zk.toFixed(3)+','+(0.7+0.02*breath).toFixed(3)+')';
  shadow.style.opacity   = (0.42 + 0.10*(1-breath)).toFixed(3);


  // 坐下犯困：持续轻微呼吸 + 头部轻晃（和待机一样是活的休息态）
  if(window.__sitBreath) window.__sitBreath(now);
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);
</script>
<script>
const ACTIONS = {'wave': ['data:image/png;base64,', 'data:image/png;base64,', 'data:image/png;base64,', 'data:image/png;base64,', 'data:image/png;base64,', 'data:image/png;base64,', 'data:image/png;base64,', 'data:image/png;base64,'], 'heart': ['data:image/png;base64,