# ===== 多功能聚合站 配置示例 =====
# 复制本文件为 .env 并填入你的值后重启服务即可生效

# 服务端口
PORT=3000

# ---- AI 聊天 / 桌宠推理（默认 DeepSeek 开放平台）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 音乐解析（第三方解析源，可替换为你自建/合规的服务）----
MUSIC_NETCLOUD_ENDPOINT=https://api.imjad.cn/cloudmusic/
MUSIC_QQ_ENDPOINT=https://api.imjad.cn/qqmusic/
# 是否由本服务代理下载音频（解决跨域/防盗链），true/false
MUSIC_PROXY_DOWNLOAD=true

# ---- AI 作曲（Suno 类外部服务，可选；留空则使用本地生成式作曲）----
COMPOSE_API_BASE=
COMPOSE_API_KEY=

# ---- 翻译（多源自动兜底，默认无需任何密钥即可用）----
# 源优先级，可选值：deepl,bing,google,google2,simply,mymemory
# 留空则使用默认顺序：bing,google,google2,simply,mymemory
TRANSLATE_PROVIDER_ORDER=
# 【推荐】DeepL API Free：免费注册、无需信用卡、50 万字符/月，配置后最稳定
# 注册地址 https://www.deepl.com/pro-api （选 Free 套餐），密钥形如 xxxx:fx
DEEPL_API_KEY=
# Bing 翻译网页接口候选域名（无需密钥）
TRANSLATE_BING_HOSTS=cn.bing.com,www.bing.com
# SimplyTranslate 公共代理实例（第三方服务，可替换）
TRANSLATE_SIMPLY_HOSTS=https://simplytranslate.org,https://translate.josias.dev
# MyMemory 兜底（按 IP 每日限额；填邮箱可提高额度）
TRANSLATE_ENDPOINT=https://api.mymemory.translated.net/get
TRANSLATE_EMAIL=
# 译文缓存时长（毫秒）
TRANSLATE_CACHE_TTL=600000
