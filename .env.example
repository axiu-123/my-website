# ===== 多功能聚合站 配置示例 =====
# 复制本文件为 .env 并填入你的值后重启服务即可生效

# 服务端口
PORT=3000

# ---- AI 聊天 / 桌宠推理（默认 DeepSeek 开放平台）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 音乐解析（第三方解析源，可替换为你自建/合规的服务）----
MUSIC_NETCLOUD_ENDPOINT=https://api.imjad.cn/cloudmusic/
MUSIC_QQ_ENDPOINT=https://api.imjad.cn/qqmusic/
# 是否由本服务代理下载音频（解决跨域/防盗链），true/false
MUSIC_PROXY_DOWNLOAD=true

# ---- AI 作曲（Suno 类外部服务，可选；留空则使用本地生成式作曲）----
COMPOSE_API_BASE=
COMPOSE_API_KEY=

# ---- 翻译（默认 MyMemory 免费接口，无需密钥）----
TRANSLATE_ENDPOINT=https://api.mymemory.translated.net/get
